# Настройки DNS-фильтра (dnsmasq + smartdns). Формат: КЛЮЧ="значение", как в sh.
# После правки: svc.sh stop; svc.sh start

# Интерфейс LAN: DNS-запросы клиентов с него перенаправляются на dnsmasq
IFACE_LAN="br0"

# Порт dnsmasq на адресе LAN
PORT="5353"

# Здесь значения по умолчанию. Выбор пользователя (PRESET, CUSTOM_DNS, ADBLOCK, DNS_USER_OFF) лежит в /online/mod/conf/dns/settings,
# читается поверх этого файла и не сбрасывается при установке новой версии.

# Пресет DNS-сервера: auto (рекомендуемый из presets.txt) или id из presets.txt. Меняется: svc.sh use-preset ID.
PRESET="auto"

# Адрес для пресета custom: https://сервер/dns-query, tls://имя или IPv4 (без шифрования). Меняется: svc.sh set-custom АДРЕС.
CUSTOM_DNS=""

# UPSTREAM, PLAIN_SERVERS и SECURE_SERVERS действуют, только если PRESET пуст; при выбранном пресете они вычисляются из него.
# Куда dnsmasq пересылает запросы:
#   stock  — в стоковый DNS роутера (127.0.0.1:53, DNS оператора, без шифрования);
#   plain  — напрямую на серверы из PLAIN_SERVERS (порт 53, без шифрования);
#   secure — в smartdns, который ходит к серверам из SECURE_SERVERS по TLS (DoT) или HTTPS (DoH).
UPSTREAM="secure"

# Серверы для режима plain, через пробел
PLAIN_SERVERS=""

# Серверы для режима secure, через пробел. Формат:
#   tls://АДРЕС#ИМЯ                  — DNS по TLS, порт 853;
#   https://АДРЕС/ПУТЬ#ИМЯ           — DNS по HTTPS, порт 443.
# ИМЯ — имя в сертификате сервера, по нему проверяется подлинность.
SECURE_SERVERS="tls://1.1.1.1#one.one.one.one tls://1.0.0.1#one.one.one.one"

# Порт smartdns на 127.0.0.1
SECURE_PORT="5453"

# 1 — пользователь выключил службу, запуск туннеля ее не поднимает. Пишется командами stop и disable, снимается start и enable.
DNS_USER_OFF="0"

# Если серверы пресета не отвечают (1 — да, 0 — нет): сначала запасные серверы, потом DNS оператора. Только для режима secure.
FALLBACK="1"
# Запасные серверы, другие сети и другой порт: DoT идет на 853, DoH на 443. Формат как у SECURE_SERVERS.
FALLBACK_SERVERS="tls://9.9.9.9#dns.quad9.net https://9.9.9.9/dns-query#dns.quad9.net https://8.8.8.8/dns-query#dns.google"
# Порт smartdns для запасных серверов на 127.0.0.1
BACKUP_PORT="5454"
# Как часто смотреть счетчики сбоев dnsmasq, с. Наружу запросов нет, пока сбоев нет
WATCH_POLL="20"
# Сколько секунд после запуска службы проверять серверы чаще: при загрузке роутера сеть и процессор заняты
START_WINDOW="300"
# Служба не запустилась или упала: как часто повторять запуск, с
START_RETRY="60"
# На запасном пути: как часто пробовать пресет снова после первых 10 попыток, с
FALLBACK_RETRY="120"

# Блокировка рекламы по списку доменов (1 — да, 0 — нет). Меняется: svc.sh adblock on|off.
ADBLOCK="1"

# Откуда скачивать список по команде update (по домену в строке; понимает и формат hosts, и ||домен^).
# По умолчанию — HaGeZi Light: реклама, счетчики, телеметрия, около 75 тысяч доменов.
LIST_URL="https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/light-onlydomains.txt"

# Сколько доменов брать из списка, не больше. Каждые 10 тысяч — около 0,55 МиБ ОЗУ у dnsmasq.
LIST_MAX="100000"

# Перехватывать DNS-запросы клиентов к любым серверам (1) или только к роутеру (0)
FORCE="1"

# Отклонять DNS-запросы клиентов по IPv6 (1 — да, 0 — нет).
# Для IPv6 нет перенаправления: без отказа клиенты могут спросить DNS мимо фильтра.
BLOCK_DNS6="1"

# Размер кэша dnsmasq, записей
CACHE="1000"
