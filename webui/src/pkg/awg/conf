# Настройки пакета AmneziaWG. Формат: КЛЮЧ="значение", как в sh. После правки: svc.sh stop; svc.sh start
# Здесь значения по умолчанию. Выбор пользователя (ENGINE, DNS_TUNNEL, SPLIT, FAILOVER, FAILOVER_PRIMARY) лежит в CONF_DIR/settings, читается поверх этого файла
# и не сбрасывается при установке новой версии.
# Конфиги туннеля (ключи, сервер, обфускация) — профили в CONF_DIR/profiles/ИМЯ.conf, их пишет svc.sh setconf ИМЯ.

# Имя интерфейса туннеля
IFACE="awg0"

# Каталог профилей: profiles/ИМЯ.conf (формат AmneziaWG, .conf из Amnezia VPN или с сервера), active — имя активного
CONF_DIR="/online/mod/conf/awg"

# Интерфейс LAN (Wi-Fi и USB) и внешний интерфейс (мобильная сеть)
IFACE_LAN="br0"
IFACE_WAN="eth_x"

# Движок туннеля: auto — модуль ядра amneziawg.ko, а если он не сработал — amneziawg-go;
# kernel — только модуль; go — только amneziawg-go. Загруженный модуль выгружать нельзя (см. README), он уходит только с перезагрузкой.
ENGINE="auto"

# MTU туннеля, если в конфиге нет MTU
MTU_DEFAULT="1280"

# Сам роутер тоже ходит в интернет через туннель (1) или только клиенты LAN (0).
# При 0 стоковые службы роутера (время, DNS оператора, smartdns) идут напрямую.
ROUTE_SELF="0"

# Блокировка утечки: если туннель упал, клиенты LAN не выходят в интернет напрямую (1 — да)
KILLSWITCH="1"

# DNS клиентов через туннель (1 — да, 0 — нет; переключение: svc.sh dns on|off). По умолчанию выключено.
# Запросы клиентов на порт 53 уходят на первый IPv4 из DNS = в конфиге туннеля, а если его нет — на DNS_TUNNEL_SERVER.
# Если запущен пакет dns, DNS клиентов обслуживает он, а к его серверам DoH и DoT ставятся маршруты через туннель.
# Действует, только если в туннель идет весь трафик (AllowedIPs = 0.0.0.0/0).
DNS_TUNNEL="0"
DNS_TUNNEL_SERVER="1.1.1.1"

# Настройка сборщика мусора Go для amneziawg-go (GOGC, проценты). Пусто — по умолчанию Go (100).
# Меньше — меньше памяти под нагрузкой, но больше работы процессора.
GO_GC="50"

# Раздельный VPN (1 — да, 0 — нет): российские адреса напрямую, остальное через туннель.
# Действует, только если есть список: svc.sh split-update ФАЙЛ. Без списка весь трафик идет в туннель, как обычно.
# Переключение: svc.sh split on|off, выбор хранится в settings.
SPLIT="1"

# Переключение профиля при обрыве (1 — да, 0 — нет). При одном профиле ничего не делает.
# Переключение: svc.sh failover on|off, выбор хранится в settings.
FAILOVER="1"
# Основной профиль; его задает failover on или выбор профиля пользователем. Пусто — профиль, активный на момент обрыва
FAILOVER_PRIMARY=""
# Нет рукопожатия дольше стольких секунд — профиль считается неработающим
FAILOVER_HS="180"
# Пауза между переходами, с
FAILOVER_PAUSE="300"
# Как часто с запасного профиля пробовать основной, с. Проба — короткий простой туннеля
FAILOVER_RETRY="1800"
# Как часто проверять, с
FAILOVER_POLL="30"

# Номер таблицы маршрутов и первый приоритет правил ip rule (заняты PRIO..PRIO+2)
TABLE="5300"
PRIO="5300"
