# Настройки tpws. Формат: КЛЮЧ="значение", как в sh. После правки: svc.sh stop; svc.sh start

# Интерфейс LAN: с него перехватываются соединения клиентов
IFACE_LAN="br0"

# Внешний интерфейс (мобильная сеть)
IFACE_WAN="eth_x"

# Порт, на котором tpws принимает перехваченные соединения (адрес br0)
PORT="988"

# Порты назначения TCP, которые идут через tpws
PORTS="80,443"

# Параметры обхода (стратегия). Профили разделяет --new.
# Порт 80: --methodeol. Порт 443: ClientHello делится на две TLS-записи перед SNI (--tlsrec=sniext),
# режется на 1-м байте и в середине домена 2-го уровня, с байтом срочных данных (--oob).
TPWS_OPT="--filter-tcp=80 --methodeol --new --filter-tcp=443 --tlsrec=sniext --split-pos=1,midsld --oob"

# Запрещать клиентам QUIC (UDP 443), 1 — да, 0 — нет. tpws работает только с TCP:
# без QUIC браузеры переходят на TCP, и обход действует на YouTube и другие сайты Google.
BLOCK_QUIC="1"

# Файл со списком доменов (по одному в строке). Пусто — обход для всех сайтов.
# Если файл задан, к обоим профилям добавляется --hostlist=ФАЙЛ.
HOSTLIST=""

# Пользователь, от которого работает tpws после запуска (uid:gid).
# Группа 3003 (inet) обязательна: ядро роутера дает сетевые сокеты только root и этой группе.
RUN_UID="65534:3003"

# Предел открытых файлов: каждое соединение через tpws занимает два
NOFILE="4096"
