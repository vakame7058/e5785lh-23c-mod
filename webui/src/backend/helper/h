# ---------- разбор запроса ----------

A=""
P_name=""; P_args=""; P_timeout_s=""; P_enable=""; P_disable=""; P_cmd=""; P_country=""
P_url=""; P_type=""; P_id=""; P_lines=""; P_pci=""; P_earfcn=""; P_mode=""; P_nobattery=""
P_bg=""; P_job=""; P_bands=""; P_server=""; P_number=""; P_source=""; P_on=""; P_via=""; P_label=""; P_direction=""; P_streams=""; P_op=""; P_primary=""; P_modem_write=""; P_nv_write=""; P_addr=""

dec() {
    case "$1" in
        *[%+]*) DV=$($B httpd -d "$1") ;;
        *) DV=$1 ;;
    esac
}

parse_query() {
    local kv k v IFS='&'
    set -f
    for kv in $QUERY_STRING; do
        k=${kv%%=*}
        v=${kv#*=}
        [ "$k" = "$kv" ] && v=""
        dec "$v"
        case "$k" in
            a) A=$DV ;;
            name) P_name=$DV ;;
            args) P_args=$DV ;;
            timeout_s) P_timeout_s=$DV ;;
            enable) P_enable=$DV ;;
            disable) P_disable=$DV ;;
            cmd) P_cmd=$DV ;;
            country) P_country=$DV ;;
            url) P_url=$DV ;;
            type) P_type=$DV ;;
            id) P_id=$DV ;;
            lines) P_lines=$DV ;;
            pci) P_pci=$DV ;;
            earfcn) P_earfcn=$DV ;;
            mode) P_mode=$DV ;;
            nobattery) P_nobattery=$DV ;;
            bg) P_bg=$DV ;;
            job) P_job=$DV ;;
            bands) P_bands=$DV ;;
            server) P_server=$DV ;;
            number) P_number=$DV ;;
            on) P_on=$DV ;;
            via) P_via=$DV ;;
            label) P_label=$DV ;;
            direction) P_direction=$DV ;;
            streams) P_streams=$DV ;;
            addr) P_addr=$DV ;;
            op) P_op=$DV ;;
            primary) P_primary=$DV ;;
            modem_write) P_modem_write=$DV ;;
            nv_write) P_nv_write=$DV ;;
            source) P_source=$DV ;;
        esac
    done
    set +f
}

reply_error() {
    printf 'Content-Type: text/plain\r\n\r\n'
    printf 'S %s\n%s\n' "$1" "$2"
}

dispatch() {
    case "$A" in
        helper.show|helper.set|sysinfo.show|signal.show|\
        cell.show|cell.set|cell.clear|\
        ttl.show|ttl.set|spe.show|spe.set|\
        scripts.show|scripts.run|scripts.result|scripts.read|scripts.save|scripts.delete|scripts.autorun|\
        at.show|at.send|wificountry.show|wificountry.set|lanname.resolve|\
        msisdn.show|msisdn.set|msisdn.parse|msisdn.query|msisdn.auto|msisdn.sms|\
        speedtest.show|speedtest.run|speedtest.servers|\
        vpn.show|vpn.start|vpn.stop|vpn.autostart|vpn.config|vpn.save|vpn.setconf|vpn.dns|\
        vpn.profile_use|vpn.profile_delete|vpn.profile_label|\
        vpn.split|vpn.split_update|vpn.split_direct|vpn.split_vpn|vpn.failover|\
        svc.show|svc.start|svc.stop|svc.enable|svc.disable|svc.status|svc.dns_preset|svc.dns_custom|svc.dns_adblock|svc.dns_enable|svc.dns_disable|\
        logs.show|logs.get|radio.show|radio.set|battery.show|battery.set)
            FN=act_$(echo "$A" | $B tr . _)
            ;;
        *)
            reply_error 9009 "Неизвестное действие: $A"
            return 1
            ;;
    esac
}

# ---------- главная часть ----------

[ "$REQUEST_METHOD" = POST ] || { reply_error 9002 "Действие запрещено"; cleanup; exit 0; }
case "$REMOTE_ADDR" in
    127.0.0.1|::1|::ffff:127.0.0.1) ;;
    *) reply_error 9002 "Действие запрещено"; cleanup; exit 0 ;;
esac

LEN=${CONTENT_LENGTH:-0}
is_uint "$LEN" && [ "$LEN" -le 400000 ] || { reply_error 9003 "Слишком большой запрос"; cleanup; exit 0; }
$B head -c "$LEN" > "$T/body"
read -r SECRET_IN < "$T/body"
SECRET=$($B cat "$H/secret" 2>/dev/null)
if [ -z "$SECRET" ] || [ "$SECRET_IN" != "$SECRET" ]; then
    A=auth; log "bad secret from $REMOTE_ADDR"
    reply_error 9002 "Действие запрещено"
    cleanup
    exit 0
fi
$B tail -c +$((${#SECRET_IN} + 2)) "$T/body" > "$T/payload"

parse_query
dispatch || { cleanup; exit 0; }

( "$FN" ) > "$T/resp" 2> "$T/stderr" < /dev/null

printf 'Content-Type: text/plain\r\n\r\n'
if [ -f "$T/err_code" ]; then
    printf 'S %s\n' "$($B cat "$T/err_code")"
    $B cat "$T/err_msg"
    [ -f "$T/err_out" ] && $B cat "$T/err_out"
    log "err $($B cat "$T/err_code")"
else
    printf 'S 0\n'
    $B cat "$T/resp"
fi
cleanup
exit 0
