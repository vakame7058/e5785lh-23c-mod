        x range "$range"; x https "$https"; x median_mbps "$med"; x upload_url "$up"
        printf '</server>'
    done
    printf '</servers>'
}

# dns_a ИМЯ СЕРВЕР — IPv4 из DNS по TCP (своего резолвера у root-процессов нет: нет net.dns1)
dns_a() {
    local name=$1 srv=$2 f=$RUN/dns.$$
    dns_q "$name" "$f" 0
    nc_req "$srv" 53 "$f" 5 > "$f.r"
    # последняя запись ответа: TYPE=A (0 1) ... RDLENGTH=4 (0 4) и 4 байта адреса
    set -- $($B tail -c 14 "$f.r" | $B od -v -An -tu1)
    $B rm -f "$f" "$f.q" "$f.r"
    [ $# = 14 ] && [ "$1 $2" = "0 1" ] && [ "$9 ${10}" = "0 4" ] || return 1
    echo "${11}.${12}.${13}.${14}"
}

# dns_q ИМЯ ФАЙЛ EDNS — запрос A для DNS по TCP (с длиной в начале); EDNS=1 — с записью OPT (EDNS0, 4096)
dns_q() {
    local name=$1 f=$2 e=$3 l n
    : > "$f.q"
    IFS=.
    for l in $name; do
        printf "\\$(printf %03o ${#l})" >> "$f.q"
        printf '%s' "$l" >> "$f.q"
    done
    IFS=$OIFS
    printf '\000\000\001\000\001' >> "$f.q"
    [ "$e" = 1 ] && printf '\000\000\051\020\000\000\000\000\000\000\000' >> "$f.q"
    n=$((12 + $($B wc -c < "$f.q")))
    {
        printf "\\$(printf %03o $((n / 256)))\\$(printf %03o $((n % 256)))"
        if [ "$e" = 1 ]; then
            printf '\022\064\001\000\000\001\000\000\000\000\000\001'
        else
            printf '\022\064\001\000\000\001\000\000\000\000\000\000'
        fi
        $B cat "$f.q"
    } > "$f"
}

# dns_has ИМЯ СЕРВЕР EDNS IP — в ответе есть запись A с адресом IP (где бы она ни стояла)
dns_has() {
    local f=$RUN/dnsh.$$ hex want
    dns_q "$1" "$f" "$3"
    nc_req "$2" 53 "$f" 5 > "$f.r"
    hex=$($B od -v -An -tx1 "$f.r" | $B tr -d ' \n')
    $B rm -f "$f" "$f.q" "$f.r"
    want=$(IFS=.; set -- $4; printf '%02x%02x%02x%02x' "$1" "$2" "$3" "$4")
    # TYPE A, CLASS IN, TTL (4 байта), RDLENGTH 4, адрес
    echo "$hex" | $B grep -q "00010001........0004$want"
}

resolve() {
    local srv ip
    case "$1" in *[!0-9.]*) ;; *) echo "$1"; return 0 ;; esac
    $B timeout -t 5 /app/hijacks/bin/web_hook_client monitoring status 1 1 > "$RUN/speed.mon" 2>/dev/null
    for srv in 127.0.0.1 \
        $($B sed -n 's:.*<PrimaryDns>\([0-9.]*\)</PrimaryDns>.*:\1:p' "$RUN/speed.mon") \
        $($B sed -n 's:.*<SecondaryDns>\([0-9.]*\)</SecondaryDns>.*:\1:p' "$RUN/speed.mon"); do
        ip=$(dns_a "$1" "$srv") && { echo "$ip"; return 0; }
    done
    return 1
}

# speed_last_t РЯД — время последней точки
speed_last_t() {
    local t l=0 rest
    [ -f "$1" ] && while read -r t rest; do l=$t; done < "$1"
    echo "$l"
}

# speed_mem — MEM_AVAIL: свободно + буферы + кэш, КБ (встроенным read, без внешних процессов)
speed_mem() {
    local k v u mf=0 mb=0 mc=0
    while read -r k v u; do
        case "$k" in
            MemFree:) mf=$v ;;
            Buffers:) mb=$v ;;
            Cached:) mc=$v; break ;;
        esac
    done < /proc/meminfo
    MEM_AVAIL=$((mf + mb + mc))
}

SPEED_TLS_NOTE="возможно, предел шифрования в процессоре"

# speed_pick_mt АВТО АДРЕС — сервер для приема в несколько потоков. На HTTPS несколько потоков упираются в шифрование
# в процессоре раньше, чем в связь. При автовыборе берется отвечающий сервер HTTP с Range и лучшей медианой,
# иначе остается прежний сервер с пометкой. Сервер, выбранный пользователем, не меняется. Итог в M_URL M_SRV M_NAME M_NOTE.
speed_pick_mt() {
    local id
    M_URL=$2; M_SRV=$DN_ID; M_NAME=$DN_NAME; M_NOTE=""
    case "$2" in https://*) ;; *) return 0 ;; esac
    if [ "$1" = 1 ]; then
        for id in $(speed_list | $B awk -F'|' '$7 == "0" && $6 == "1" {print $8 "|" $1}' | $B sort -t'|' -k1 -n -r | $B cut -d'|' -f2); do
            speed_find "$id" || continue
            speed_connect "$S_URL" 1 > /dev/null || continue
            M_URL=$S_URL; M_SRV=$S_ID; M_NAME=$S_NAME; DN_RANGE=$S_RANGE; DN_SIZE=$S_SIZE
            return 0
        done
    fi
    M_NOTE=$SPEED_TLS_NOTE
}

# speed_mt НАПРАВЛЕНИЕ N ВСЕГО_БАЙТ ТАЙМАУТ ИНТЕРФЕЙС АДРЕС РЯД — фаза из N одновременных curl.
# Всего байт делится между потоками: объем замера не растет с N. Ни один поток не пишет на диск и в ОЗУ:
# прием в /dev/null, отдача — чтение общего разреженного файла.
# Прием: разные участки файла (-r), если он достаточно велик; сервер без Range — поток режет head.
# Отдача: один POST на поток или (сервер с лимитом тела, up_mode=chunks) куски по 1 МиБ через --next.
# Скорость — по счетчику интерфейса после разгона (speed_window).
# Итог в MT_BYTES MT_US MT_KBPS MT_WIN MT_CNT MT_MEM MT_ERR.
speed_mt() {
    local d=$1 n=$2 tot=$3 to=$4 dev=$5 url=$6 ser=$7 lim i=0 start r pids="" need
    local mm=$RUN/speed.done.mt bf=$RUN/speed.body.mt body cnt j p c0 c1 a b c e g ok okn=0 dm=0 dmin="" pm="" di pi lastcode=""
    local fmt='%{size_download} %{time_total} %{time_starttransfer} %{http_code} %{exitcode}'
    MT_BYTES=0; MT_US=0; MT_KBPS=""; MT_WIN=""; MT_CNT=""; MT_MEM=""; MT_ERR=""
    speed_mem
    need=$((16384 + n * 4096))
    if [ "$MEM_AVAIL" -lt "$need" ]; then
        MT_ERR="потоки не запускались: мало памяти, доступно $((MEM_AVAIL / 1024)) МиБ, нужно $((need / 1024))"
        return 0
    fi
    lim=$((tot / n))
    $B rm -f "$mm" "$RUN"/speed.mt.*
    if [ "$d" = up ]; then
        fmt='%{size_upload} %{time_total} %{time_pretransfer} %{http_code} %{exitcode}'
        body=$lim; cnt=1
        case "$umode" in chunks*) body=1048576; cnt=$((lim / 1048576)); [ "$cnt" -gt 0 ] || cnt=1 ;; esac
        speed_up_file "$bf" "$body"
        c0=$(speed_txb "$dev")
    else
        c0=$(speed_rx "$dev")
    fi
    if [ "$d" = up ]; then
        speed_sampler "$mm" $(( (to + 2) * 4 )) "$dev" tx "$ser" &
    else
        speed_sampler "$mm" $(( (to + 2) * 4 )) "$dev" rx "$ser" &
    fi
    p=$!
    while [ $i -lt "$n" ]; do
        if [ "$d" = up ]; then
            (
                set --
                j=0
                while [ $j -lt "$cnt" ]; do
                    [ $j -gt 0 ] && set -- "$@" --next
                    set -- "$@" -s -o /dev/null $SPEED_IFOPT --connect-timeout 3 --max-time "$to" --cacert "$CACERT" -X POST -T "$bf" \
                        -H 'Content-Type: application/octet-stream' -H 'Expect:' -w "$fmt\\n" "$url"
                    j=$((j + 1))
                done
                $B timeout -t $((to + 3)) "$CURL" "$@" > "$RUN/speed.mt.$i" 2>/dev/null
            ) < /dev/null &
        elif [ "$DN_RANGE" = 1 ]; then
            start=0
            case "$DN_SIZE" in ''|*[!0-9]*) ;; *) [ $((n * lim)) -le "$DN_SIZE" ] && start=$((i * lim)) ;; esac
            r="-r $start-$((start + lim - 1))"
            $B timeout -t $((to + 3)) "$CURL" -s -o /dev/null $r $SPEED_IFOPT --connect-timeout 3 --max-time "$to" \
                --cacert "$CACERT" -w "$fmt\\n" "$url" > "$RUN/speed.mt.$i" 2>/dev/null < /dev/null &
        else
            (
                $B timeout -t $((to + 3)) "$CURL" -s -o - $SPEED_IFOPT --connect-timeout 3 --max-time "$to" \
                    --cacert "$CACERT" -w "%{stderr}$fmt\\n" "$url" 2> "$RUN/speed.mt.$i" | $B head -c "$lim" > /dev/null
            ) < /dev/null &
        fi
        pids="$pids $!"
        i=$((i + 1))
    done
    wait $pids
    if [ "$d" = up ]; then speed_end "$ser" tx "$dev"; else speed_end "$ser" rx "$dev"; fi
    : > "$mm"
    wait "$p"
    if [ "$d" = up ]; then c1=$(speed_txb "$dev"); else c1=$(speed_rx "$dev"); fi
    MT_CNT=$((c1 - c0))
    i=0
    while [ $i -lt "$n" ]; do
        ok=0; di=0; pi=""
        if [ -f "$RUN/speed.mt.$i" ]; then
            while read -r a b c e g; do
                lastcode=$e
                case "$e:$g" in
                    2??:*|*:28) ;;
                    *) continue ;;
                esac
                [ "${a:-0}" -gt 0 ] || continue
                ok=1
                MT_BYTES=$((MT_BYTES + a))
                di=$((di + $(tus "$b")))
                [ -n "$pi" ] || pi=$(tus "$c")
            done < "$RUN/speed.mt.$i"
        fi
        if [ "$ok" = 1 ]; then
            okn=$((okn + 1))
            [ "$di" -gt "$dm" ] && dm=$di
            if [ -z "$dmin" ] || [ "$di" -lt "$dmin" ]; then dmin=$di; fi
            if [ -z "$pm" ] || [ "$pi" -lt "$pm" ]; then pm=$pi; fi
        fi
        i=$((i + 1))
    done
    $B rm -f "$RUN"/speed.mt.* "$bf" "$mm"
    if [ "$okn" = 0 ]; then
        case "$lastcode" in
            '') MT_ERR="потоки не дали ответа: не хватило памяти или нет соединения" ;;
            000) MT_ERR="потоки не прошли: нет соединения с сервером" ;;
            *) MT_ERR="потоки не прошли: сервер ответил $lastcode" ;;
        esac
    else
        [ "$okn" = "$n" ] || MT_ERR="работали $okn из $n потоков"
        MT_US=$((dm - ${pm:-0})); [ "$MT_US" -gt 0 ] || MT_US=1
        speed_window "$ser" "$((dmin / 1000))"
        MT_KBPS=$W_KBPS; MT_WIN=$W_S
    fi
    MT_MEM=""
    while read -r a b c e g; do
        if [ -z "$MT_MEM" ] || [ "${e:-0}" -lt "$MT_MEM" ]; then MT_MEM=$e; fi
    done < "$ser"
}

# speed_end РЯД rx|tx ИНТЕРФЕЙС — время и счетчик интерфейса сразу после конца передачи, для speed_window
speed_end() {
    local v rest b
    read -r v rest < /proc/uptime
    if [ "$2" = tx ]; then b=$(speed_txb "$3"); else b=$(speed_rx "$3"); fi
    echo "${v%%.*}${v##*.} $b" > "$1.end"
}

# speed_window РЯД [КОНЕЦ_МС] — скорость после разгона: байты интерфейса от первой точки не раньше 2 с до конца передачи.
# КОНЕЦ_МС — когда закончил первый из потоков: дальше скорость падает из-за предела объема, а не из-за связи,
# поэтому конец — последняя точка до этого времени, если от начала отрезка до нее не меньше 500 мс.
# Фаза короче 2 с — за всю фазу. Итог в W_KBPS (кбит/с) и W_S (секунды).
speed_window() {
    local p0 b0 cu b t c k m cb t0=0 cb0=0 te ce ms lim=${2:-0} lt=0 lc=0
    W_KBPS=""; W_S=""
    [ -f "$1.start" ] && [ -f "$1.end" ] || return 0
    read -r p0 b0 < "$1.start"
    read -r cu b < "$1.end"
    te=$(( (cu - p0) * 10 )); ce=$((b - b0))
    [ -f "$1" ] && while read -r t c k m cb; do
        if [ "$t0" = 0 ] && [ "$t" -ge 2000 ]; then t0=$t; cb0=$cb; fi
        if [ "$t" -le "$lim" ]; then lt=$t; lc=$cb; fi
    done < "$1"
    if [ "$t0" -gt 0 ] && [ $((lt - t0)) -ge 500 ]; then te=$lt; ce=$lc; fi
    ms=$((te - t0))
    if [ "$ms" -lt 200 ]; then t0=0; cb0=0; ms=$te; fi
    [ "$ms" -gt 0 ] || return 0
    W_KBPS=$(( (ce - cb0) * 8 / ms ))
    W_S="$((ms / 1000)).$((ms % 1000 / 100))"
}

# speed_sampler МЕТКА МАКС_ТИКОВ ИНТЕРФЕЙС — раз в 250 мс строка "t_мс cpu_pct kbps память байты_с_начала" в $RUN/speed.series.
# Сам почти не грузит ЦП: /proc/stat, /proc/uptime и /proc/net/dev читает встроенным read,
# внешний процесс за тик один — usleep.
# speed_sampler МЕТКА МАКС_ТИКОВ ИНТЕРФЕЙС [rx|tx] [ФАЙЛ]
speed_sampler() {
    local m=$1 lim=$2 dev=$3 cf=/sys/class/net/$3/statistics/rx_bytes out=${5:-$RUN/speed.series} i=0 b0 c us ni sy id io irq sirq st rest pt pi ct ci p0 pu cu prx rx v dt r ph off=0 tt t
    # фаза и сдвиг времени: внутри samples и up_samples время сквозное
    case "$out" in
        *.dm) ph=download_mt; off=$(speed_last_t "$RUN/speed.series") ;;
        *.up) ph=upload ;;
        *.um) ph=upload_mt; off=$(speed_last_t "$RUN/speed.series.up") ;;
        *) ph=download ;;
    esac
    : > "$out.xml"
    # счетчик — одной строкой из /sys: разбор /proc/net/dev встроенным read идет по байту и заметно нагружает ЦП
    [ "$4" = tx ] && cf=/sys/class/net/$3/statistics/tx_bytes
    : > "$out"
    read -r c us ni sy id io irq sirq st rest < /proc/stat
    pt=$((us + ni + sy + id + io + irq + sirq + ${st:-0})); pi=$((id + io))
    read -r v rest < /proc/uptime; pu=${v%%.*}${v##*.}; p0=$pu
    prx=0
    read -r prx < "$cf"
    b0=$prx
    echo "$p0 $b0" > "$out.start"
    while [ ! -f "$m" ] && [ $i -lt "$lim" ]; do
        $B usleep 250000
        i=$((i + 1))
        read -r c us ni sy id io irq sirq st rest < /proc/stat
        ct=$((us + ni + sy + id + io + irq + sirq + ${st:-0})); ci=$((id + io))
        read -r v rest < /proc/uptime; cu=${v%%.*}${v##*.}
        rx=$prx
        read -r rx < "$cf"
        dt=$((ct - pt)); [ "$dt" -gt 0 ] || dt=1
        r=$((cu - pu)); [ "$r" -gt 0 ] || r=1
        # время в мс от начала; скорость — байты * 8 / (сотые * 10) = кбит/с
        speed_mem
        echo "$(( (cu - p0) * 10 )) $(( (100 * (dt - (ci - pi)) + dt / 2) / dt )) $(( (rx - prx) * 4 / (r * 5) )) $MEM_AVAIL $((rx - b0))" >> "$out"
        tt=$(( (cu - p0) * 10 + off ))
        printf '<s><phase>%s</phase><t>%d.%02d</t><t_ms>%s</t_ms><cpu_pct>%s</cpu_pct><kbps>%s</kbps></s>' \
            "$ph" $((tt / 1000)) $((tt % 1000 / 10)) "$tt" "$(( (100 * (dt - (ci - pi)) + dt / 2) / dt ))" "$(( (rx - prx) * 4 / (r * 5) ))" >> "$out.xml"
        pt=$ct; pi=$ci; pu=$cu; prx=$rx
    done
}

# speed_rx ИНТЕРФЕЙС — принято байт (из /proc/net/dev)
speed_rx() {
    local l r
    while read -r l; do
        case "$l" in
            "$1:"*)
                r=${l#*:}
                set -- $r
                echo "${1:-0}"
                return 0
                ;;
        esac
    done < /proc/net/dev
    echo 0
}

# speed_txb ИНТЕРФЕЙС — отправлено байт (9-е поле после "имя:" в /proc/net/dev)
speed_txb() {
    local l
    while read -r l; do
        case "$l" in "$1:"*) set -- ${l#*:}; echo "${9:-0}"; return 0 ;; esac
    done < /proc/net/dev
    echo 0
}

# speed_tcp — счетчики TCP всей системы: TCP_RETR (RetransSegs), TCP_OUT (OutSegs) из /proc/net/snmp
speed_tcp() {
    local l
    TCP_RETR=0; TCP_OUT=0
    while read -r l; do
        case "$l" in
            Tcp:*[0-9]*)
                set -- $l
                case "${13}" in ''|*[!0-9]*) ;; *) TCP_RETR=${13}; TCP_OUT=${12} ;; esac
                ;;
        esac
    done < /proc/net/snmp
}

# speed_up_file ФАЙЛ РАЗМЕР — тело отдачи: разреженный файл (читается как нули, ОЗУ почти не занимает).
# Нули, а не /dev/urandom: на этом ЦП urandom дает 8 МиБ за 4,9 с и сам ограничивал бы скорость.
speed_up_file() {
    $B rm -f "$1"
    $B dd if=/dev/zero of="$1" bs=1 count=0 seek="$2" 2>/dev/null
    [ "$($B wc -c < "$1")" = "$2" ] || $B head -c "$2" /dev/zero > "$1"
}

# speed_upload АДРЕС ТАЙМАУТ ИНТЕРФЕЙС — отдача до UCAP байт и до ТАЙМАУТ с, одним соединением:
# каждое новое соединение — пауза на TCP+TLS без данных, на графике это пила.
#   обычно: один POST на 8 МиБ (curl -T шлет файл потоком, не читая в память);
#   есть лимит тела (HostKey: 413 от 2 МиБ; другие — по 413 или ошибке): POST по 1 МиБ через --next,
#   curl держит то же соединение (num_connects 0 у следующих).
# Скорость: байты / сумма (time_total − time_pretransfer). Итог в ubytes uus nup uok ucode umode uconn.
speed_upload() {
    local url=$1 to=$2 dev=$3 f=$RUN/speed.body w0 w left o
    local fmt='%{size_upload} %{time_total} %{time_pretransfer} %{http_code} %{exitcode} %{num_connects}'
    ubytes=0; uus=0; nup=0; uok=0; ucode=""; umode=single; uconn=0; ucurl=""; ubad=0
    rf /proc/uptime; w0=${RV%% *}; w0=${w0%%.*}${w0##*.}
    case "$url" in *hostkey.com*) umode=chunks ;; esac
    if [ "$umode" = single ]; then
        speed_up_file "$f" "$UCAP"
        o=$($B timeout -t $((to + 5)) "$CURL" -s -o /dev/null $SPEED_IFOPT --connect-timeout 3 --max-time "$to" \
            --cacert "$CACERT" -X POST -T "$f" -H 'Content-Type: application/octet-stream' -H 'Expect:' \
            -w "$fmt" "$url" 2>>"$E")
        set -- $o
        nup=1; ucode=$4; uconn=${6:-0}; ucurl=$5
        rf /proc/uptime; w=${RV%% *}; w=${w%%.*}${w##*.}
        case "$ucode:$5" in
            2??:*)
                ubytes=${1:-0}
                uus=$(( $(tus "${2:-0}") - $(tus "${3:-0}") ))
                [ "$ubytes" -gt 0 ] && uok=1
                ;;
            *:28)
                # оборвано по общему времени: отданное считается. Раньше (рукопожатие не прошло) — куски
                if [ "${1:-0}" -gt 0 ] && [ $((w - w0)) -ge $((to * 100 - 100)) ]; then
                    ubytes=$1
                    uus=$(( $(tus "${2:-0}") - $(tus "${3:-0}") ))
                    uok=1
                else
                    umode=chunks
                fi
                ;;
            *) umode=chunks ;;
        esac
        # ни байта тела: рукопожатие или соединение не прошли, счетчику интерфейса верить нельзя
        [ "$umode" = chunks ] && [ "${1:-0}" = 0 ] && ubad=1
    fi
    if [ "$umode" = chunks ]; then
        rf /proc/uptime; w=${RV%% *}; w=${w%%.*}${w##*.}
        left=$((to * 100 - (w - w0)))
        if [ "$left" -gt 50 ]; then
            speed_up_chunks "$url" "$((left / 100 + 1))" "$dev"
        fi
    fi
    $B rm -f "$f"
}

# speed_up_chunks АДРЕС ТАЙМАУТ ИНТЕРФЕЙС — POST по 1 МиБ (всего UCAP) в одном curl (--next, одно соединение).
# curl пишет -w по мере переходов; по таймауту он убит, последние строки могут потеряться: скорость
# по оставшимся строкам верна. Ни одной строки (медленно) — байты по tx интерфейса и время по часам.
speed_up_chunks() {
    local url=$1 to=$2 dev=$3 f=$RUN/speed.body i=0 tx0 w0 w l a b c d e g
    local fmt='%{size_upload} %{time_total} %{time_pretransfer} %{http_code} %{exitcode} %{num_connects}\n'
    speed_up_file "$f" 1048576
    # пробный большой POST, если был, не считается
    ucode=""; nup=0
    tx0=$(speed_txb "$dev")
    rf /proc/uptime; w0=${RV%% *}; w0=${w0%%.*}${w0##*.}
    set --
    while [ $i -lt $((UCAP / 1048576)) ]; do
        [ $i -gt 0 ] && set -- "$@" --next
        set -- "$@" -s -o /dev/null $SPEED_IFOPT --connect-timeout 3 --max-time "$to" --cacert "$CACERT" -X POST -T "$f" \
            -H 'Content-Type: application/octet-stream' -H 'Expect:' -w "$fmt" "$url"
        i=$((i + 1))
    done
    $B timeout -t "$to" "$CURL" "$@" > "$RUN/speed.up.w" 2>>"$E"
    while read -r a b c d e g; do
        ucode=$d
        case "$d" in 2??) ;; *) continue ;; esac
        nup=$((nup + 1)); uok=$((uok + 1)); uconn=$((uconn + ${g:-0}))
        ubytes=$((ubytes + ${a:-0}))
        l=$(( $(tus "${b:-0}") - $(tus "${c:-0}") )); [ "$l" -gt 0 ] && uus=$((uus + l))
    done < "$RUN/speed.up.w"
    if [ "$nup" = 0 ]; then
        rf /proc/uptime; w=${RV%% *}; w=${w%%.*}${w##*.}
        ubytes=$(( $(speed_txb "$dev") - tx0 ))
        uus=$(( (w - w0) * 10000 ))
        # строк нет совсем: curl убит на первом куске; отказ сервера дал бы строку с кодом.
        # Оценка по счетчику — только если соединение точно работало и ушло заметно больше рукопожатия
        if [ "$ubytes" -ge 131072 ] && [ -z "$ucode" ] && [ "$ubad" != 1 ]; then
            uok=1; umode=chunks_est
        else
            ubytes=0
        fi
    fi
    $B rm -f "$RUN/speed.up.w"
}

# tus A — секунды вида 1.234567 (curl -w) в микросекунды
tus() {
    echo $(( ${1%%.*} * 1000000 + $(echo "${1#*.}000000" | $B cut -c1-6 | $B sed 's/^0*//;s/^$/0/') ))
}

# tsub A B — разность секунд вида 1.234567 (curl -w), результат того же вида
tsub() {
    local a b
    a=$(( ${1%%.*} * 1000000 + $(echo "${1#*.}000000" | $B cut -c1-6 | $B sed 's/^0*//;s/^$/0/') ))
    b=$(( ${2%%.*} * 1000000 + $(echo "${2#*.}000000" | $B cut -c1-6 | $B sed 's/^0*//;s/^$/0/') ))
    a=$((a - b)); [ "$a" -gt 0 ] || a=1
    printf '%d.%06d' $((a / 1000000)) $((a % 1000000))
}

# speed_pick_up — сервер отдачи, если у выбранного для приема его нет: среди всех с upload_url
# (9-е поле) с самым быстрым соединением, по тому же пути (--interface при via). Любой ответ HTTP годится:
# адрес отдачи на HEAD может отвечать 405. Итог в U_ID U_NAME U_URL; код 1 — ни один не ответил
speed_pick_up() {
    local id ms o best="" bestms=""
    for id in $(speed_list | $B grep '^\([^|]*|\)\{8\}[^|]\{1,\}' | $B cut -d'|' -f1); do
        speed_find "$id" || continue
        o=$($B timeout -t 6 "$CURL" -s -o /dev/null -I $SPEED_IFOPT --connect-timeout 3 --max-time 4 --cacert "$CACERT" \
            -w '%{time_connect} %{http_code}' "$S_UP" 2>/dev/null)
        set -- $o
        case "$2" in ''|000) echo "up:$id -" >> "$RUN/speed.cand"; continue ;; esac
        ms=$(( $(tus "$1") / 1000 ))
        echo "up:$id $ms" >> "$RUN/speed.cand"
        if [ -z "$bestms" ] || [ "$ms" -lt "$bestms" ]; then best=$id; bestms=$ms; fi
    done
    [ -n "$best" ] || return 1
    speed_find "$best" || return 1
    U_ID=$S_ID; U_NAME=$S_NAME; U_URL=$S_UP
}

# speed_connect URL RANGE — время TCP-соединения в мс (curl -w time_connect), код 1 при ошибке;
# RANGE=1 — сервер отдает часть файла (-r 0-0), иначе запрос HEAD
speed_connect() {
    local o r="-I"
    [ "$2" = 1 ] && r="-r 0-0"
    o=$($B timeout -t 6 "$CURL" -s -o /dev/null $r $SPEED_IFOPT --max-time 4 --cacert "$CACERT" \
        -w '%{time_connect} %{http_code}' "$1" 2>/dev/null)
    set -- $o
    case "$2" in 2??) ;; *) return 1 ;; esac
    # секунды с дробью → мс
    echo $(( ${1%%.*} * 1000 + $(echo "${1#*.}000" | $B cut -c1-3 | $B sed 's/^0*//;s/^$/0/') ))
}

# замер в фоне; результат — XML-фрагмент в $RUN/speedtest
speed_measure() {
    local sel=$1 url=$2 to=$3 via=$4 dir=$5 streams=${6:-1} st=error bytes=0 secs=0 kbps=0 code ip dev E=$RUN/speedtest.err M=$RUN/speed.done
    local o id best="" bestms="" ms n=0 rng w0 w left nreq=0 xus b cms=""
    local wan auto=0 tot ust="" ubytes=0 uus=0 ukbps="" ucode MU=$RUN/speed.done.up nup=0 uok=0 umode="" uconn=0 utx="" ures="" uos="" rs0 os0 tx0 uerr="" ucurl="" ubad=0
    : > "$E"
    UP_CPU_AVG=""
    # по умолчанию прием и отдача; о любой неудаче отдачи говорят up_status и up_error
    [ -n "$dir" ] || dir=both
    [ "$sel" = auto ] && auto=1
    DIR=$dir; U_ID=""; U_NAME=""; U_URL=""
    M_SRV=""; M_NAME=""; M_NOTE=""; UM_NOTE=""
    # предел объема на фазу, МиБ: с потоками 16 + 30 + 6 + 12, без потоков 30 + 12. Срабатывает на быстрой связи.
    # Всего с потоками 64 МиБ, через туннель 58: счетчик eth_x на них показывает около 72 и 71 МБ (+7 % и +17 %)
    if [ "$streams" -gt 1 ]; then DCAP=16777216; UCAP=6291456; else DCAP=31457280; UCAP=12582912; fi
    TOTAL=67108864; [ -n "$via" ] && TOTAL=60817408
    W_DN=""; W_UP=""; WAN0=""
    M_KBPS=""; M_WIN=""; M_BYTES=""; M_US=0; M_CNT=""; M_MEM=""; M_ERR=""; M_CPU_AVG=""; UM_KBPS=""; UM_WIN=""; UM_BYTES=""; UM_US=0; UM_CNT=""; UM_MEM=""; UM_ERR=""; UM_CPU_AVG=""
    [ "$dir" = down ] || { ust=error; uerr="отдача не удалась: нет сети"; }
    $B rm -f "$M" "$MU" "$RUN/speed.series" "$RUN/speed.series.up" "$RUN/speed.series.dm" "$RUN/speed.series.um" "$RUN/speed.cur" "$RUN/speed.cand" "$RUN"/speed.series*.start "$RUN"/speed.series*.end "$RUN"/speed.series*.xml
    dev=$($B ip route show default 2>/dev/null | $B sed -n 's/^default .* dev \([^ ]*\).*/\1/p' | $B head -n1)
    # через туннель: curl --interface, скорость в точках — по приему на интерфейсе туннеля
    # для стенда: интерфейс для точек скорости можно задать (SPEED_DEV)
    [ -n "$SPEED_DEV" ] && dev=$SPEED_DEV
    # весь трафик замера: по счетчику внешнего интерфейса; через туннель там те же данные с его заголовками
    wan=$dev
    [ -n "$wan" ] && WAN0=$(( $(speed_rx "$wan") + $(speed_txb "$wan") ))
    SPEED_IFOPT=""; VIA=direct; VPN_PROFILE=""; VPN_LABEL=""
    if [ -n "$via" ]; then
        dev=$via; SPEED_IFOPT="--interface $via"; VIA=awg
        # какой профиль AmneziaWG сейчас активен (из status, без ключей)
        awg_svc 10 status > "$RUN/speed.awg" 2>/dev/null
        VPN_PROFILE=$($B sed -n 's/^profile=//p' "$RUN/speed.awg" | $B head -n1)
        VPN_LABEL=$($B sed -n 's/^profile_label=//p' "$RUN/speed.awg" | $B head -n1)
        $B rm -f "$RUN/speed.awg"
    fi
    if [ -z "$dev" ]; then
        st=nonet
        echo "нет маршрута по умолчанию" > "$E"
    else
        [ "$sel" = auto ] && { x status running; x phase select; x server auto; } > "$RUN/speed.info"
        if [ "$sel" = auto ] && [ ! -x "$CURL" ]; then
            # без curl — первый сервер с http://
            sel=$(speed_list | $B grep -m1 '^[^|]*|[^|]*|[^|]*|http://' | $B cut -d'|' -f1)
        elif [ "$sel" = auto ]; then
            # 3 сервера с лучшей медианой; из них — с самым быстрым соединением
            # для отдачи — только серверы с адресом отдачи (9-е поле)
            for id in $(speed_list | { if [ "$dir" = up ]; then $B grep '^\([^|]*|\)\{8\}[^|]\{1,\}'; else $B cat; fi; } \
                    | $B sort -t'|' -k8 -n -r | $B cut -d'|' -f1 | $B head -n 3); do
                speed_find "$id" || continue
                ms=$(speed_connect "$S_URL" "$S_RANGE") || { echo "$id -" >> "$RUN/speed.cand"; continue; }
                echo "$id $ms" >> "$RUN/speed.cand"
                if [ -z "$bestms" ] || [ "$ms" -lt "$bestms" ]; then best=$id; bestms=$ms; fi
            done
            [ -n "$best" ] || best=$(speed_list | $B head -n1 | $B cut -d'|' -f1)
            sel=$best
        fi
        if [ -n "$sel" ] && speed_find "$sel"; then url=$S_URL; else S_ID=""; S_NAME=""; S_RANGE=""; S_UP=""; fi
        # отдача: у выбранного сервера или, если у него адреса нет, у лучшего из других (см. speed_pick_up)
        U_ID=$S_ID; U_NAME=$S_NAME; U_URL=$S_UP
        [ -n "$U_URL" ] || { U_ID=""; U_NAME=""; }
        DN_ID=$S_ID; DN_NAME=$S_NAME; DN_RANGE=$S_RANGE; DN_SIZE=$S_SIZE
        {
            x status running; x phase download; x server "$DN_ID"; x name "$DN_NAME"; x url "$url"
            x direction "$dir"; x via "$VIA"; x vpn_profile "$VPN_PROFILE"; x vpn_label "$VPN_LABEL"
        } > "$RUN/speed.info"
        [ "$dir" = up ] || speed_sampler "$M" $(( (to + 2) * 4 )) "$dev" &
        if [ "$dir" = up ]; then
            :
        elif [ -x "$CURL" ]; then
            # не больше DCAP с начала файла (зеркала меняют файлы) и не дольше to секунд;
            # файл кончился раньше — запрос повторяется, пока не выйдет время или объем.
            rng=""
            rf /proc/uptime; w0=${RV%% *}; w0=${w0%%.*}${w0##*.}
            bytes=0; xus=0; nreq=0
            while :; do
                rf /proc/uptime; w=${RV%% *}; w=${w%%.*}${w##*.}
                left=$((to * 100 - (w - w0)))
                [ "$left" -gt 50 ] || break
                [ "$S_RANGE" = 1 ] && rng="-r 0-$((DCAP - bytes - 1))"
                if [ -n "$rng" ]; then
                    o=$($B timeout -t $((left / 100 + 5)) "$CURL" -s -o /dev/null $rng $SPEED_IFOPT \
                        --max-time "$((left / 100)).$((left % 100 / 10))" --cacert "$CACERT" \
                        -w '%{size_download} %{time_total} %{time_starttransfer} %{http_code} %{remote_ip} %{time_connect}' "$url" 2>>"$E")
                else
                    # сервер без Range: объем режет head, curl завершается ошибкой записи — это норма
                    $B timeout -t $((left / 100 + 5)) "$CURL" -s -o - $SPEED_IFOPT \
                        --max-time "$((left / 100)).$((left % 100 / 10))" --cacert "$CACERT" \
                        -w '%{stderr}%{size_download} %{time_total} %{time_starttransfer} %{http_code} %{remote_ip} %{time_connect}' "$url" 2>"$RUN/speed.o" \
                        | $B head -c "$((DCAP - bytes))" > /dev/null
                    o=$($B cat "$RUN/speed.o")
                    $B rm -f "$RUN/speed.o"
                fi
                set -- $o
                nreq=$((nreq + 1))
                # время TCP-соединения первого запроса, мс
                [ $nreq = 1 ] && [ -n "$6" ] && cms=$(( $(tus "$6") / 1000 ))
                code=$4; ip=$5
                bytes=$((bytes + ${1:-0}))
                b=$(( $(tus "${2:-0}") - $(tus "${3:-0}") )); [ "$b" -gt 0 ] && xus=$((xus + b))
                case "$code" in 200|206) ;; *) break ;; esac
                [ "$bytes" -ge "$DCAP" ] && break
            done
            secs=$(printf '%d.%06d' $((xus / 1000000)) $((xus % 1000000)))
        else
            case "$url" in https://*) echo "нет curl для https" >> "$E" ;; esac
            speed_nc "$url" "$to"
            nreq=1
        fi
        [ "$dir" = up ] || speed_end "$RUN/speed.series" rx "$dev"
        : > "$M"
        wait
        if [ "$dir" != up ]; then
            case "$code" in
                200|206) [ "$bytes" -gt 0 ] && st=ok ;;
                000|'') $B grep -q -i -e 'resolve' -e 'unreachable' "$E" && st=nonet ;;
            esac
            [ "$st" = ok ] || [ -z "$code" ] || echo "HTTP $code" >> "$E"
            # секунды "1.234567" → сотые
            n=$(( ${secs%%.*} * 100 + $(echo "${secs#*.}00" | $B cut -c1-2 | $B sed 's/^0//') ))
            [ "$n" -gt 0 ] || n=1
            kbps=$((bytes * 4 / (n * 5)))
            speed_window "$RUN/speed.series"
            if [ "$st" = ok ] && [ -n "$W_KBPS" ]; then kbps=$W_KBPS; W_DN=$W_S; fi
        fi
        # прием в несколько потоков; реальный объем прошлой фазы учитывается
        if [ "$streams" -gt 1 ] && [ "$dir" != up ]; then
            if [ "$st" != ok ]; then
                M_ERR="потоки не запускались: прием в один поток не удался"
            elif [ ! -x "$CURL" ]; then
                M_ERR="потоки не запускались: нет curl (пакет dns)"
            else
                tot=$((TOTAL - bytes)); [ "$dir" = both ] && tot=$((tot - 18874368))
                [ "$tot" -le 31457280 ] || tot=31457280
                if [ "$tot" -lt $((streams * 1048576)) ]; then
                    M_ERR="потоки не запускались: лимит трафика замера"
                else
                    speed_pick_mt "$auto" "$url"
                    {
                        x status running; x phase download_mt; x streams "$streams"; x server "$M_SRV"; x name "$M_NAME"
                        x url "$M_URL"; x direction "$dir"; x via "$VIA"; x vpn_profile "$VPN_PROFILE"; x vpn_label "$VPN_LABEL"
                    } > "$RUN/speed.info"
                    echo "$RUN/speed.series.dm" > "$RUN/speed.cur"
                    speed_mt down "$streams" "$tot" "$to" "$dev" "$M_URL" "$RUN/speed.series.dm"
                    M_KBPS=$MT_KBPS; M_WIN=$MT_WIN; M_BYTES=$MT_BYTES; M_US=$MT_US; M_CNT=$MT_CNT; M_MEM=$MT_MEM; M_ERR=$MT_ERR
                fi
            fi
        fi
        # отдача — см. speed_upload; точки — по tx интерфейса. Молча не пропускается никогда
        uerr=""; ust=""
        if [ "$dir" != down ] && [ -z "$U_URL" ] && [ -x "$CURL" ]; then
            { x status running; x phase select_up; x server "$DN_ID"; x name "$DN_NAME"; x direction "$dir"; x via "$VIA"; } > "$RUN/speed.info"
            speed_pick_up
        fi
        if [ "$dir" != down ] && [ ! -x "$CURL" ]; then
            ust=error; uerr="отдача не удалась: нет curl (пакет dns)"
        elif [ "$dir" != down ] && [ -z "$U_URL" ]; then
            ust=error; uerr="отдача не удалась: ни один сервер отдачи не отвечает"
        elif [ "$dir" != down ]; then
            {
                x status running; x phase upload; x server "$DN_ID"; x name "$DN_NAME"; x url "$U_URL"
                x up_server "$U_ID"; x up_name "$U_NAME"
                x direction "$dir"; x via "$VIA"; x vpn_profile "$VPN_PROFILE"; x vpn_label "$VPN_LABEL"
            } > "$RUN/speed.info"
            : > "$RUN/speed.series.up"
            echo "$RUN/speed.series.up" > "$RUN/speed.cur"
            speed_tcp; rs0=$TCP_RETR; os0=$TCP_OUT
            tx0=$(speed_txb "$dev")
            speed_sampler "$MU" $(( (to + 2) * 4 )) "$dev" tx "$RUN/speed.series.up" &
            speed_upload "$U_URL" "$to" "$dev"
            speed_end "$RUN/speed.series.up" tx "$dev"
            : > "$MU"
            wait
            speed_tcp; ures=$((TCP_RETR - rs0)); uos=$((TCP_OUT - os0))
            utx=$(( $(speed_txb "$dev") - tx0 ))
            [ "$uus" -gt 0 ] || uus=1
            ukbps=$(( ubytes * 8000 / uus ))
            if [ "$uok" -gt 0 ] && [ "$ubytes" -gt 0 ]; then
                ust=ok
                speed_window "$RUN/speed.series.up"
                if [ -n "$W_KBPS" ]; then ukbps=$W_KBPS; W_UP=$W_S; fi
            else
                ust=error; ukbps=""
                case "$ucode" in
                    ''|000) uerr="отдача не удалась: нет соединения с сервером" ;;
                    *) uerr="отдача не удалась: сервер ответил $ucode" ;;
                esac
            fi
            # прием прошел — замер не ошибка, не удалась только отдача (up_status, up_error)
            # отдача в несколько потоков
            if [ "$streams" -gt 1 ] && [ "$ust" = ok ]; then
                tot=$((TOTAL - bytes - ${M_BYTES:-0} - ubytes))
                [ "$tot" -le 12582912 ] || tot=12582912
                if [ "$tot" -lt $((streams * 1048576)) ]; then
                    UM_ERR="потоки не запускались: лимит трафика замера"
                else
                    {
                        x status running; x phase upload_mt; x streams "$streams"; x server "$DN_ID"; x name "$DN_NAME"; x url "$U_URL"
                        x up_server "$U_ID"; x up_name "$U_NAME"; x direction "$dir"; x via "$VIA"; x vpn_profile "$VPN_PROFILE"; x vpn_label "$VPN_LABEL"
                    } > "$RUN/speed.info"
                    echo "$RUN/speed.series.um" > "$RUN/speed.cur"
                    case "$U_URL" in https://*) UM_NOTE=$SPEED_TLS_NOTE ;; esac
                    speed_mt up "$streams" "$tot" "$to" "$dev" "$U_URL" "$RUN/speed.series.um"
                    UM_KBPS=$MT_KBPS; UM_WIN=$MT_WIN; UM_BYTES=$MT_BYTES; UM_US=$MT_US; UM_CNT=$MT_CNT; UM_MEM=$MT_MEM; UM_ERR=$MT_ERR
                fi
            elif [ "$streams" -gt 1 ]; then
                UM_ERR="потоки не запускались: отдача в один поток не удалась"
            fi
        fi
        [ "$dir" = up ] && st=$ust
        [ -z "$uerr" ] || echo "$uerr" >> "$E"
    fi
    {
        x status "$st"; x server "$DN_ID"; x name "$DN_NAME"; x url "$url"; x ip "$ip"
        x via "$VIA"; x vpn_profile "$VPN_PROFILE"; x vpn_label "$VPN_LABEL"; x connect_ms "$cms"
        x bytes "$bytes"; x seconds "$((n / 100)).$((n % 100 / 10))"; x speed_kbps "$kbps"
        x requests "$nreq"
        x direction "$DIR"
        if [ "$DIR" != up ]; then speed_cpu_stats "$RUN/speed.series"; DN_CPU_AVG=$CPU_AVG; else DN_CPU_AVG=""; fi
        if [ "$DIR" != down ]; then
            x up_status "$ust"; x up_error "$uerr"; x up_server "$U_ID"; x up_name "$U_NAME"; x upload_url "$U_URL"; x up_bytes "$ubytes"
            x up_seconds "$((uus / 1000000)).$((uus % 1000000 / 100000))"; x up_kbps "$ukbps"; x up_requests "$nup"
            x up_mode "$umode"; x up_connections "$uconn"; x up_tx_bytes "$utx"; x up_retrans "$ures"; x up_outsegs "$uos"
            speed_cpu_stats "$RUN/speed.series.up" up_
            UP_CPU_AVG=$CPU_AVG
            speed_samples_xml up_samples "$RUN/speed.series.up" "$RUN/speed.series.um"
        fi
        x streams "$streams"
        [ -n "$WAN0" ] && { b=$(( $(speed_rx "$wan") + $(speed_txb "$wan") - WAN0 )); x traffic_mb "$((b / 1000000)).$((b % 1000000 / 100000))"; }
        x window_s "$W_DN"; x up_window_s "$W_UP"
        if [ "$streams" -gt 1 ]; then
            if [ "$DIR" != up ]; then
                x mt_server "$M_SRV"; x mt_name "$M_NAME"; x mt_note "$M_NOTE"
                x mt_streams "$streams"; x mt_kbps "$M_KBPS"; x mt_window_s "$M_WIN"; x mt_bytes "$M_BYTES"
                x mt_seconds "$((M_US / 1000000)).$((M_US % 1000000 / 100000))"; x mt_rx_bytes "$M_CNT"
                speed_cpu_stats "$RUN/speed.series.dm" mt_
                x mt_mem_min_kb "$M_MEM"; x mt_error "$M_ERR"
            fi
            if [ "$DIR" != down ]; then
                x up_mt_note "$UM_NOTE"
                x up_mt_kbps "$UM_KBPS"; x up_mt_window_s "$UM_WIN"; x up_mt_bytes "$UM_BYTES"
                x up_mt_seconds "$((UM_US / 1000000)).$((UM_US % 1000000 / 100000))"; x up_mt_tx_bytes "$UM_CNT"
                speed_cpu_stats "$RUN/speed.series.um" up_mt_
                x up_mt_mem_min_kb "$UM_MEM"; x up_mt_error "$UM_ERR"
            fi
        fi
        x time "$($B date +%s)"
        if [ -s "$RUN/speed.cand" ]; then
            printf '<candidates>'
            while read -r id ms; do printf '<c>'; x id "$id"; x connect_ms "$ms"; printf '</c>'; done < "$RUN/speed.cand"
            printf '</candidates>'
        fi
        speed_samples_xml samples "$RUN/speed.series" "$RUN/speed.series.dm"
        [ "$st" = ok ] || xfile output "$E"
    } > "$RUN/speedtest.tmp"
    $B mv -f "$RUN/speedtest.tmp" "$RUN/speedtest"
    speed_history_add "$($B date +%s)" "${DN_ID:-${url:-$U_ID}}" "$VIA" "$VPN_LABEL" "$([ "$DIR" = up ] || echo "$kbps")" "$DN_CPU_AVG" "$cms" "$st" "$ukbps" "$UP_CPU_AVG" "$U_ID" "$streams" "$M_KBPS" "$UM_KBPS"
    $B rm -f "$M" "$RUN/speed.info" "$RUN/speed.cur" "$RUN/speed.cand" "$RUN/speed.req" "$RUN/speed.head" "$RUN/speed.mon" "$RUN/speedtest.pid" "$RUN/speed.history.xml" "$RUN"/speed.series*.start "$RUN"/speed.series*.end "$RUN"/speed.series*.xml
    log "speedtest $st ${S_ID:-url}${via:+ через $via} $DIR: прием $bytes B ${n}0 ms${ukbps:+, отдача $umode $ubytes B $ukbps кбит/с, соединений $uconn, повторов TCP $ures из $uos}"
}

# без curl: http:// через nc (DNS по TCP), результат в bytes, secs, code, ip
speed_nc() {
    local url=$1 to=$2 hp host port path t0 t1 h M2=$RUN/speed.ncdone
    hp=${url#http://}
    case "$hp" in */*) path=/${hp#*/} ;; *) path=/ ;; esac
    hp=${hp%%/*}; host=${hp%%:*}; port=80
    case "$hp" in *:*) port=${hp##*:} ;; esac
    ip=$(resolve "$host") || { code=000; echo "не удалось узнать адрес $host" >> "$RUN/speedtest.err"; return 0; }
    printf 'GET %s HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n\r\n' "$path" "$host" > "$RUN/speed.req"
    $B rm -f "$M2"
    rf /proc/uptime; t0=${RV%% *}; t0=${t0%%.*}${t0##*.}
    nc_hold "$RUN/speed.req" "$to" "$M2" \
        | { $B timeout -t "$to" $B nc "$ip" "$port" 2>>"$RUN/speedtest.err"; : > "$M2"; } \
        | { $B head -c 512 > "$RUN/speed.head"; $B wc -c > "$RUN/speed.count"; }
    rf /proc/uptime; t1=${RV%% *}; t1=${t1%%.*}${t1##*.}
    bytes=$(($($B cat "$RUN/speed.count") + $($B wc -c < "$RUN/speed.head")))
    h=$($B head -n1 "$RUN/speed.head" | $B tr -d '\r')
    code=$(echo "$h" | $B sed -n 's:^HTTP/1\.[01] \([0-9]*\).*:\1:p')
    secs=$(printf '%d.%02d' $(( (t1 - t0) / 100 )) $(( (t1 - t0) % 100 )))
    $B rm -f "$M2" "$RUN/speed.count"
}

act_speedtest_run() {
    local sel=${P_server:-} url=$P_url to=${P_timeout_s:-8} via="" streams
    is_uint "$to" && [ "$to" -ge 3 ] && [ "$to" -le 60 ] || fail 9003 "Неверное значение: timeout_s"
    case "$P_direction" in ''|down|up|both) ;; *) fail 9003 "Неверное значение: direction (down, up или both)" ;; esac
    # без поля — 4 потока (выбрано замером, см. API.md); без curl потоков нет, замер идет через nc
    if [ -n "$P_streams" ]; then
        streams=$P_streams
        case "$streams" in 1|2|3|4) ;; *) fail 9003 "Неверное значение: streams (от 1 до 4)" ;; esac
        [ "$streams" = 1 ] || [ -x "$CURL" ] || fail 9006 "Не найдено: curl (пакет dns) — замер в несколько потоков без него невозможен"
    else
        streams=4
        [ -x "$CURL" ] || streams=1
    fi
    case "$P_via" in
        '') ;;
        awg)
            [ -x "$CURL" ] || fail 9006 "Не найдено: curl (пакет dns) — замер через туннель без него невозможен"
            $IP link show "$AWG_IF" > /dev/null 2>&1 || fail 9006 "Туннель AmneziaWG не поднят: замер через него невозможен"
            via=$AWG_IF
            ;;
        *) fail 9003 "Неверное значение: via (пусто или awg)" ;;
    esac
    if [ -n "$url" ]; then
        case "$url" in http://*|https://*) ;; *) fail 9003 "Неверное значение: url (http:// или https://)" ;; esac
        case "$url" in *[!A-Za-z0-9.:/_%?=\&+~-]*) fail 9003 "Неверное значение: url" ;; esac
        sel=""
    else
        [ -n "$sel" ] || sel=auto
        case "$sel" in
            auto) ;;
            *[!A-Za-z0-9_.-]*) fail 9003 "Неверное значение: server" ;;
            *) speed_find "$sel" || fail 9006 "Не найдено: сервер $sel"
               [ "$P_direction" = up ] && [ -z "$S_UP" ] && fail 9006 "Не найдено: у сервера $sel нет адреса отдачи"
               ;;
        esac
    fi
    speed_running && fail 9002 "Замер уже идет"
    { x status running; x phase start; x server "$sel"; x url "$url"; } > "$RUN/speed.info"
    speed_history_xml > "$RUN/speed.history.xml"
    : > "$RUN/speed.series"
    ( speed_measure "$sel" "$url" "$to" "$via" "$P_direction" "$streams" ) < /dev/null > /dev/null 2>&1 &
    echo $! > "$RUN/speedtest.pid"
    log "speedtest start ${sel:-$url}${via:+ через $via}"
    x status running
    x server "$sel"
    x url "$url"
    x direction "$P_direction"
    x streams "$streams"
    [ -n "$via" ] && x via awg || x via direct
}

# ---------- vpn ----------

# ip из /system/bin (iproute2): busybox ip не знает "type wireguard"
IP=/system/bin/ip

# AmneziaWG — пакет awg: svc.sh start|stop|status|enable|disable|setconf
AWG_PKG=${AWG_PKG:-/online/mod/pkg/awg}
AWG_CONF=${AWG_CONF:-/online/mod/conf/awg/awg0.conf}
AWG_IF=${AWG_IF:-awg0}
AWG_PROFILES=${AWG_CONF%/*}/profiles

# awg_svc ТАЙМАУТ КОМАНДА [АРГУМЕНТ…] — стандартный ввод из AWG_IN (по умолчанию /dev/null)
awg_svc() {
    local f=$AWG_PKG/svc.sh t=$1
    shift
    if [ -x "$f" ]; then
        $B timeout -t "$t" "$f" "$@" < "${AWG_IN:-/dev/null}"
    else
        $B timeout -t "$t" $B sh "$f" "$@" < "${AWG_IN:-/dev/null}"
    fi
}

# состояние AmneziaWG: только известные поля status, ключи не выводятся
awg_state() {
    local k v
    AP_NAME=""; AP_LABEL=""
    printf '<awg>'
    if [ ! -f "$AWG_PKG/svc.sh" ]; then
        x installed 0; x configured 0; x up 0; x autostart 0
        printf '</awg>'
        return 0
    fi
    x installed 1
    if [ -s "$AWG_CONF" ] || [ -n "$($B ls "$AWG_PROFILES" 2>/dev/null | $B grep -m1 '\.conf$')" ]; then
        x configured 1
    else
        x configured 0
    fi
    awg_svc 10 status > "$T/awg.st" 2>/dev/null
    for k in running enabled info rx tx handshake dns dns_server profile profile_label engine engine_fallback \
        split split_active split_list split_prefixes split_date split_reason split_hint failover failover_reason primary; do
        v=$($B sed -n "s/^$k=//p" "$T/awg.st" | $B head -n1)
        case "$k" in
            running) [ "$v" = 1 ] && x up 1 || x up 0 ;;
            enabled) [ "$v" = 1 ] && x autostart 1 || x autostart 0 ;;
            rx) x rx_bytes "$v" ;;
            tx) x tx_bytes "$v" ;;
            handshake) x handshake_s "$v" ;;
            # DNS клиентов LAN: tunnel — через туннель, operator — DNS оператора, dnspkg — пакет dns
            dns) x dns_mode "$v" ;;
            # активный профиль — ниже, вместе со списком (имя <profile> занято элементом списка)
            profile) AP_NAME=$v ;;
            profile_label) AP_LABEL=$v ;;
            *) x "$k" "$v" ;;
        esac
    done
    # пакет без раздельного VPN строку split= не печатает: списки не запрашиваются
    if $B grep -q '^split=' "$T/awg.st"; then
        awg_split_list direct split_direct
        awg_split_list vpn split_vpn
    fi
    $B rm -f "$T/awg.st"
    awg_profiles
    x active_profile "$AP_NAME"
    x active_label "$AP_LABEL"
    printf '</awg>'
}

# awg_split_list direct|vpn ЭЛЕМЕНТ — свои исключения раздельного VPN: <ЭЛЕМЕНТ><addr>…</addr>…</ЭЛЕМЕНТ>
awg_split_list() {
    local l
    printf '<%s>' "$2"
    awg_svc 10 "split-$1" list 2>/dev/null | while read -r l; do
        case "$l" in ''|*[!0-9./]*) continue ;; esac
        x addr "$l"
    done
    printf '</%s>' "$2"
}

# Профили: "svc.sh profiles" печатает для каждого профиля строки name=, active=,
# endpoint_host=, label=, proto= (без ключей). Пакет без профилей (код 2, «использование») — элемента <profiles> нет.
awg_profiles() {
    local l k v open=0 act="" actl="" PL=""
    awg_svc 10 profiles > "$T/awg.pr" 2>/dev/null || { $B rm -f "$T/awg.pr"; return 0; }
    printf '<profiles>'
    while read -r l; do
        k=${l%%=*}; v=${l#*=}
        [ "$k" = "$l" ] && continue
        case "$k" in
            name)
                [ $open = 1 ] && printf '</profile>'
                printf '<profile>'; x name "$v"; open=1 ;;
            active)
                [ $open = 1 ] && x active "$v"
                [ "$v" = 1 ] && { act=$PN; actl=$PL; } ;;
            endpoint_host) [ $open = 1 ] && x endpoint_host "$v" ;;
            # подпись, как ввел пользователь (UTF-8); x экранирует & < >
            label) [ $open = 1 ] && x label "$v"; PL=$v ;;
            # версия протокола AmneziaWG у профиля (2.0, 3.1, …)
            proto) [ $open = 1 ] && x proto "$v" ;;
        esac
        [ "$k" = name ] && { PN=$v; PL=""; }
    done < "$T/awg.pr"
    [ $open = 1 ] && printf '</profile>'
    printf '</profiles>'
    # пакет без строк profile= в status — активный по списку
    [ -n "$AP_NAME" ] || AP_NAME=$act
    [ -n "$AP_LABEL" ] || AP_LABEL=$actl
    $B rm -f "$T/awg.pr"
}

# check_profile_name — имя профиля AmneziaWG: a-z, 0-9, _ и -, 1–32 символа
check_profile_name() {
    case "$P_name" in ''|*[!a-z0-9_-]*) fail 9003 "Неверное значение: name (a-z, 0-9, _ и -, до 32 символов)" ;; esac
    [ ${#P_name} -le 32 ] || fail 9003 "Неверное значение: name (длиннее 32 символов)"
}

# check_label — подпись профиля: UTF-8 до 64 символов, без перевода строк и управляющих символов
check_label() {
    local c chars=0
    [ -n "$P_label" ] || fail 9003 "Неверное значение: label (пусто)"
    # по байтам: управляющие (меньше 32 и 127) — нельзя; символов UTF-8 = байтов, кроме продолжений 128–191
    set -f
    for c in $(printf '%s' "$P_label" | $B od -v -An -tu1); do
        if [ "$c" -lt 32 ] || [ "$c" -eq 127 ]; then
            fail 9003 "Неверное значение: label (перевод строки или управляющие символы)"
        fi
        if [ "$c" -lt 128 ] || [ "$c" -gt 191 ]; then chars=$((chars + 1)); fi
    done
    set +f
    [ "$chars" -le 64 ] || fail 9003 "Неверное значение: label (длиннее 64 символов)"
}

act_vpn_profile_label() {
    check_vpn_type
    [ "$P_type" = awg ] || fail 9003 "Неверное значение: type (профили есть только у awg)"
    check_profile_name
    check_label
    need_awg
    awg_has_profiles || fail 9004 "Пакет AmneziaWG не умеет работать с профилями (нет команды svc.sh profiles)"
    local rc
    awg_svc 30 label "$P_name" "$P_label" > "$T/out" 2>&1
    rc=$?
    log "vpn awg profile label $P_name rc=$rc"
    [ "$rc" = 0 ] || fail 9004 "Пакет AmneziaWG не сменил подпись (код $rc)" "$T/out"
    awg_state
    awg_out "$T/out"
}

# профили есть у пакета (svc.sh profiles не отвечает «использование»)
awg_has_profiles() { awg_svc 10 profiles > /dev/null 2>&1; }

act_vpn_profile_use() {
    check_vpn_type
    [ "$P_type" = awg ] || fail 9003 "Неверное значение: type (профили есть только у awg)"
    check_profile_name
    need_awg
    awg_has_profiles || fail 9004 "Пакет AmneziaWG не умеет работать с профилями (нет команды svc.sh profiles)"
    local rc
    awg_svc 60 use "$P_name" > "$T/out" 2>&1
    rc=$?
    log "vpn awg profile use $P_name rc=$rc"
    [ "$rc" = 0 ] || fail 9004 "Пакет AmneziaWG не переключил профиль (код $rc)" "$T/out"
    awg_state
    awg_out "$T/out"
}

act_vpn_profile_delete() {
    check_vpn_type
    [ "$P_type" = awg ] || fail 9003 "Неверное значение: type (профили есть только у awg)"
    check_profile_name
    need_awg
    awg_has_profiles || fail 9004 "Пакет AmneziaWG не умеет работать с профилями (нет команды svc.sh profiles)"
    local rc
    awg_svc 30 delete "$P_name" > "$T/out" 2>&1
    rc=$?
    log "vpn awg profile delete $P_name rc=$rc"
    [ "$rc" = 0 ] || fail 9004 "Пакет AmneziaWG не удалил профиль (код $rc)" "$T/out"
    awg_state
    awg_out "$T/out"
}

# вывод команд пакета без строк с ключами
awg_out() {
    $B grep -v -i -e 'privatekey' -e 'presharedkey' "$1" > "$1.safe" 2>/dev/null
    xfile output "$1.safe"
    $B rm -f "$1.safe"
}

need_awg() {
    [ -f "$AWG_PKG/svc.sh" ] || fail 9006 "Не найдено: пакет AmneziaWG ($AWG_PKG) не установлен"
}

wg_up() { $IP link show wg0 > /dev/null 2>&1; }
ovpn_pid() {
    local p
    p=$($B cat "$RUN/ovpn.pid" 2>/dev/null)
    is_uint "$p" && [ -d "/proc/$p" ] && $B grep -q openvpn "/proc/$p/cmdline" 2>/dev/null && echo "$p"
}

vpn_state() {
    case "$1" in
        wg)
            printf '<wg>'
            [ -s "$WG_CONF" ] && x configured 1 || x configured 0
            wg_up && x up 1 || x up 0
            [ -f "$VPN_DIR/wg.autostart" ] && x autostart 1 || x autostart 0
            [ -f /etc/autorun.d/vpn.sh ] && x autostart_mod 1 || x autostart_mod 0
            printf '</wg>'
            ;;
        ovpn)
            printf '<ovpn>'
            [ -s "$OVPN_CONF" ] && x configured 1 || x configured 0
            [ -n "$(ovpn_pid)" ] && x up 1 || x up 0
            [ -f "$VPN_DIR/ovpn.autostart" ] && x autostart 1 || x autostart 0
            printf '</ovpn>'
            ;;
    esac
}

act_vpn_show() { vpn_state wg; vpn_state ovpn; awg_state; }

check_vpn_type() {
    case "$P_type" in wg|ovpn|awg) ;; *) fail 9003 "Неверное значение: type" ;; esac
}

vpn_conf() { [ "$P_type" = wg ] && echo "$WG_CONF" || echo "$OVPN_CONF"; }

# тот же порядок, что VPN_ON_SCRIPT в hijacks/scripts/vpn.sh мода
wg_start() {
    [ -s "$WG_CONF" ] || fail 9006 "Не найдено: $WG_CONF"
    {
        insmod /system/modules/ip_tunnel.ko 2>/dev/null
        insmod /system/modules/wireguard.ko 2>/dev/null
        $IP link add dev wg0 type wireguard
        /system/xbin/wg setconf wg0 "$WG_CONF"
        $IP link set dev wg0 up
        $IP route add default dev wg0 table 29500
    } > "$T/out" 2>&1
}

ovpn_start() {
    [ -s "$OVPN_CONF" ] || fail 9006 "Не найдено: $OVPN_CONF"
    [ -n "$(ovpn_pid)" ] && return 0
    [ -c /dev/net/tun ] || { $B mkdir -p /dev/net; $B mknod /dev/net/tun c 10 200; }
    cd "$VPN_DIR" && /system/xbin/openvpn --config "$OVPN_CONF" --daemon modovpn \
        --writepid "$RUN/ovpn.pid" --log "$RUN/ovpn.log" > "$T/out" 2>&1
    $B sleep 2
}

act_vpn_start() {
    check_vpn_type
    if [ "$P_type" = awg ]; then
        need_awg
        awg_svc 60 start > "$T/out" 2>&1
        log "vpn start awg rc=$?"
        awg_state
        awg_out "$T/out"
        return 0
    fi
    if [ "$P_type" = wg ]; then wg_up || wg_start; else ovpn_start; fi
    log "vpn start $P_type"
    vpn_state "$P_type"
    [ -f "$T/out" ] && xfile output "$T/out"
}

act_vpn_stop() {
    check_vpn_type
    local p
    if [ "$P_type" = awg ]; then
        need_awg
        awg_svc 60 stop > "$T/out" 2>&1
        log "vpn stop awg rc=$?"
        awg_state
        awg_out "$T/out"
        return 0
    fi
    if [ "$P_type" = wg ]; then
        $IP link del dev wg0 > "$T/out" 2>&1
    else
        p=$(ovpn_pid)
        [ -n "$p" ] && kill "$p"
        $B sleep 1
        [ -n "$(ovpn_pid)" ] || $B rm -f "$RUN/ovpn.pid"
    fi
    log "vpn stop $P_type"
    vpn_state "$P_type"
}

act_vpn_autostart() {
    check_vpn_type
    is_flag "$P_enable" || fail 9003 "Неверное значение: enable"
    if [ "$P_type" = awg ]; then
        need_awg
        if [ "$P_enable" = 1 ]; then awg_svc 30 enable > "$T/out" 2>&1; else awg_svc 30 disable > "$T/out" 2>&1; fi
        log "vpn autostart awg=$P_enable rc=$?"
        awg_state
        awg_out "$T/out"
        return 0
    fi
    $B mkdir -p "$VPN_DIR"
    if [ "$P_enable" = 1 ]; then : > "$VPN_DIR/$P_type.autostart"; else $B rm -f "$VPN_DIR/$P_type.autostart"; fi
    log "vpn autostart $P_type=$P_enable"
    vpn_state "$P_type"
}

act_vpn_config() {
    check_vpn_type
    local f
    if [ "$P_type" = awg ]; then
        # профиль: по имени, иначе активный, иначе одиночный awg0.conf
        f=$AWG_CONF
        [ -z "$P_name" ] && [ -f "${AWG_CONF%/*}/active" ] && read -r P_name < "${AWG_CONF%/*}/active"
        if [ -n "$P_name" ]; then
            check_profile_name
            f=$AWG_PROFILES/$P_name.conf
        fi
        [ -f "$f" ] || fail 9006 "Не найдено: $f"
        # ключи не отдаем: строки PrivateKey и PresharedKey заменены
        $B sed -e 's/^\([[:space:]]*[Pp]rivate[Kk]ey[[:space:]]*=\).*/\1 (скрыт)/' \
               -e 's/^\([[:space:]]*[Pp]reshared[Kk]ey[[:space:]]*=\).*/\1 (скрыт)/' "$f" > "$T/awg.conf"
        x name "$P_name"
        OUT_MAX=262144 xfile content "$T/awg.conf"
        $B rm -f "$T/awg.conf"
        return 0
    fi
    f=$(vpn_conf)
    [ -f "$f" ] || fail 9006 "Не найдено: $f"
    OUT_MAX=262144 xfile content "$f"
}

# vpn dns: DNS клиентов LAN через туннель AmneziaWG (svc.sh dns on|off), туннель не останавливается
act_vpn_dns() {
    check_vpn_type
    [ "$P_type" = awg ] || fail 9003 "Неверное значение: type (dns есть только у awg)"
    is_flag "$P_on" || fail 9003 "Неверное значение: on"
    need_awg
    local rc
    if [ "$P_on" = 1 ]; then awg_svc 30 dns on > "$T/out" 2>&1; else awg_svc 30 dns off > "$T/out" 2>&1; fi
    rc=$?
    log "vpn dns awg on=$P_on rc=$rc"
    [ "$rc" = 2 ] && fail 9004 "Пакет AmneziaWG не умеет переключать DNS (нет команды svc.sh dns)" "$T/out"
    [ "$rc" = 0 ] || fail 9004 "Пакет AmneziaWG не переключил DNS (код $rc)" "$T/out"
    awg_state
    awg_out "$T/out"
}

# awg_do ТАЙМАУТ КОМАНДА [АРГУМЕНТ…] — команда пакета; ответ — состояние <awg>, отказ — 9004 с текстом пакета как есть
awg_do() {
    local rc t=$1
    shift
    need_awg
    awg_svc "$t" "$@" > "$T/out" 2>&1
    rc=$?
    log "vpn $1 ${2:-} rc=$rc"
    [ "$rc" = 0 ] || fail 9004 "$($B head -n1 "$T/out" | $B cut -c1-200)" "$T/out"
    awg_state
    awg_out "$T/out"
}

act_vpn_split() {
    is_flag "$P_on" || fail 9003 "Неверное значение: on"
    if [ "$P_on" = 1 ]; then awg_do 60 split on; else awg_do 60 split off; fi
}

# Список российских адресов: файл во временном каталоге запроса, проверку и замену делает пакет
act_vpn_split_update() {
    [ -s "$T/payload" ] || fail 9003 "Неверное значение: list_b64"
    $B base64 -d < "$T/payload" > "$T/new" 2>"$T/b64err" || fail 9003 "Неверное значение: list_b64" "$T/b64err"
    [ -s "$T/new" ] || fail 9003 "Неверное значение: list_b64"
    $B rm -f "$T/payload"
    awg_do 60 split-update "$T/new"
    $B rm -f "$T/new"
}

# check_prefix_addr — адрес IPv4 или подсеть: только запись; длину и лишние биты проверяет пакет
check_prefix_addr() {
    local a=${P_addr%%/*} o IFS_OLD=$IFS
    case "$P_addr" in
        */*/*|*/) fail 9003 "Неверное значение: addr (IPv4 или подсеть, например 203.0.113.0/24)" ;;
        */*) is_uint "${P_addr#*/}" && [ "${#P_addr}" -le 18 ] && [ "${P_addr#*/}" -le 32 ] \
            || fail 9003 "Неверное значение: addr (IPv4 или подсеть, например 203.0.113.0/24)" ;;
    esac
    case "$a" in
        *.*.*.*.*|*..*|.*|*.) fail 9003 "Неверное значение: addr (IPv4 или подсеть, например 203.0.113.0/24)" ;;
        *.*.*.*) ;;
        *) fail 9003 "Неверное значение: addr (IPv4 или подсеть, например 203.0.113.0/24)" ;;
    esac
    IFS=.
    set -- $a
    IFS=$IFS_OLD
    for o in "$@"; do
        is_uint "$o" && [ "${#o}" -le 3 ] && [ "$o" -le 255 ] \
            || fail 9003 "Неверное значение: addr (IPv4 или подсеть, например 203.0.113.0/24)"
    done
}

# split_ex direct|vpn — свои исключения
split_ex() {
    case "$P_op" in add|del) ;; *) fail 9003 "Неверное значение: op (add или del)" ;; esac
    check_prefix_addr
    awg_do 30 "split-$1" "$P_op" "$P_addr"
}
act_vpn_split_direct() { split_ex direct; }
act_vpn_split_vpn() { split_ex vpn; }

act_vpn_failover() {
    is_flag "$P_on" || fail 9003 "Неверное значение: on"
    if [ "$P_on" = 0 ]; then
        awg_do 30 failover off
    elif [ -n "$P_primary" ]; then
        P_name=$P_primary
        check_profile_name
        awg_do 30 failover on "$P_primary"
    else
        awg_do 30 failover on
    fi
}

# setconf — то же, что save (другое имя того же действия)
act_vpn_setconf() { act_vpn_save; }

act_vpn_save() {
    check_vpn_type
    local f rc
    if [ "$P_type" = awg ]; then
        need_awg
        # имя профиля обязательно; пакет без профилей получает конфиг без имени
        check_profile_name
        [ -n "$P_label" ] && check_label
        $B base64 -d < "$T/payload" > "$T/new" 2>"$T/b64err" || fail 9003 "Неверное значение: content_b64" "$T/b64err"
        [ "$($B wc -c < "$T/new")" -le 65536 ] || fail 9003 "Конфиг больше 64 КБ"
        AWG_IN="$T/new"
        if ! awg_has_profiles; then
            awg_svc 30 setconf > "$T/out" 2>&1
        elif [ -n "$P_label" ]; then
            awg_svc 30 setconf "$P_name" "$P_label" > "$T/out" 2>&1
        else
            awg_svc 30 setconf "$P_name" > "$T/out" 2>&1
        fi
        rc=$?
        AWG_IN=""
        $B rm -f "$T/new" "$T/payload"
        log "vpn save awg ${P_name} rc=$rc"
        if [ "$rc" != 0 ]; then
            $B grep -v -i -e 'privatekey' -e 'presharedkey' "$T/out" > "$T/out.safe"
            fail 9004 "Пакет AmneziaWG не принял конфиг (код $rc)" "$T/out.safe"
        fi
        awg_state
        awg_out "$T/out"
        return 0
    fi
    f=$(vpn_conf)
    $B base64 -d < "$T/payload" > "$T/new" 2>"$T/b64err" || fail 9003 "Неверное значение: content_b64" "$T/b64err"
    [ "$($B wc -c < "$T/new")" -le 65536 ] || fail 9003 "Конфиг больше 64 КБ"
    $B mkdir -p "$VPN_DIR"
    $B cp "$T/new" "$f.tmp" && $B chmod 600 "$f.tmp" && $B mv -f "$f.tmp" "$f" || fail 9004 "Не удалось записать $f"
    log "vpn save $P_type"
    vpn_state "$P_type"
}

# ---------- svc (пакеты: /online/mod/pkg/<имя>/svc.sh start|stop|status|enable|disable) ----------

check_pkg_name() {
    case "$P_name" in ''|.*|*[!A-Za-z0-9_.-]*) fail 9003 "Неверное значение: name" ;; esac
    [ -f "$PKG/$P_name/svc.sh" ] || fail 9006 "Не найдено: $P_name"
}

# svc_exec ТАЙМАУТ ИМЯ КОМАНДА
# svc.sh start должен сам отвязать демон от вывода (свой журнал или /dev/null)
svc_exec() {
    local f=$PKG/$2/svc.sh t=$1
    shift 2
    if [ -x "$f" ]; then
        $B timeout -t "$t" "$f" "$@" < /dev/null
    else
        $B timeout -t "$t" $B sh "$f" "$@" < /dev/null
    fi
}

# svc_state ИМЯ — <running>, <enabled>, <info> по выводу "svc.sh status" (строки running=, enabled=, info=)
svc_state() {
    local rc r e
    svc_exec 10 "$1" status > "$T/st" 2>&1
    rc=$?
    r=$($B sed -n 's/^running=\([01]\).*/\1/p' "$T/st" | $B head -n1)
    e=$($B sed -n 's/^enabled=\([01]\).*/\1/p' "$T/st" | $B head -n1)
    [ -n "$r" ] || { [ $rc = 0 ] && r=1 || r=0; }
    [ -n "$e" ] || e=0
    x running "$r"; x enabled "$e"
    x info "$($B sed -n 's/^info=//p' "$T/st" | $B head -n1)"
    [ "$1" = dns ] && svc_dns_fields
}

# Адрес своего сервера DNS из настроек пакета. Участки пути DoH перед dns-query могут быть личным ключом: вместо них «…»
svc_dns_custom_addr() {
    local a r h
    a=$($B sed -n 's/^CUSTOM_DNS="\(.*\)"$/\1/p' "${DNS_SETTINGS:-/online/mod/conf/dns/settings}" 2>/dev/null | $B head -n1)
    case "$a" in
        https://*/dns-query)
            r=${a#https://}; h=${r%%/*}
            [ "${r#*/}" = dns-query ] || a="https://$h/…/dns-query"
            ;;
    esac
    printf '%s' "$a"
}

# Пакет dns: выбор сервера и блокировка рекламы (строки preset=, preset_label=, adblock= из status — в $T/st)
svc_dns_fields() {
    local k l id label act
    for k in preset preset_label adblock dns_fallback dns_upstream user_off last_error; do
        x "$k" "$($B sed -n "s/^$k=//p" "$T/st" | $B head -n1)"
    done
    # рекомендуемый — на него указывает auto (6-е поле presets.txt)
    x custom_addr "$(svc_dns_custom_addr)"
    x recommended "$($B awk -F'|' '!/^#/ && NF >= 6 && $6 == "1" {print $1; exit}' "$PKG/dns/presets.txt" 2>/dev/null)"
    svc_exec 10 dns presets > "$T/pr" 2>/dev/null || return 0
    printf '<presets>'
    while IFS='|' read -r id label act; do
        case "$id" in ''|*[!a-z0-9_-]*) continue ;; esac
        printf '<dns_preset>'; x id "$id"; x label "$label"; x active "${act:-0}"; printf '</dns_preset>'
    done < "$T/pr"
    printf '</presets>'
    $B rm -f "$T/pr"
}

# svc_dns_do КОМАНДА [АРГУМЕНТ] — команда пакета dns; ошибка — текстом пакета как есть, служба сама не стартует
svc_dns_do() {
    local rc
    [ -f "$PKG/dns/svc.sh" ] || fail 9006 "Не найдено: пакет dns"
    svc_exec 30 dns "$@" > "$T/out" 2>&1
    rc=$?
    log "svc dns $1 ${2:-} rc=$rc"
    if [ "$rc" != 0 ]; then
        fail 9004 "$($B head -n1 "$T/out" | $B cut -c1-200)" "$T/out"
    fi
    P_name=dns
    x name dns
    svc_state dns
    xfile output "$T/out"
}

act_svc_dns_preset() {
    case "$P_id" in ''|*[!a-z0-9_-]*) fail 9003 "Неверное значение: id" ;; esac
    [ ${#P_id} -le 32 ] || fail 9003 "Неверное значение: id"
    svc_dns_do use-preset "$P_id"
}

act_svc_dns_custom() {
    # адрес уходит в файл настроек пакета: только символы адреса
    case "$P_addr" in ''|*[!A-Za-z0-9.:/_-]*) fail 9003 "Неверное значение: addr (https://сервер/dns-query, tls://имя или IPv4)" ;; esac
    [ ${#P_addr} -le 200 ] || fail 9003 "Неверное значение: addr (длиннее 200 символов)"
    svc_dns_do set-custom "$P_addr"
}

# Служба DNS: автозапуск поднимает ее снова, пока включен, поэтому включение и выключение идут парой команд пакета.
# dns_do_pair КОМАНДА КОМАНДА — вторая выполняется и при отказе первой; отказ — 9004 с текстом пакета как есть
dns_do_pair() {
    local rc1 rc2 msg=""
    [ -f "$PKG/dns/svc.sh" ] || fail 9006 "Не найдено: пакет dns"
    svc_exec 30 dns "$1" > "$T/out1" 2>&1
    rc1=$?
    svc_exec 60 dns "$2" > "$T/out2" 2>&1
    rc2=$?
    log "svc dns $1 rc=$rc1, $2 rc=$rc2"
    $B cat "$T/out1" "$T/out2" > "$T/out"
    [ "$rc2" = 0 ] || msg=$($B head -n1 "$T/out2" | $B cut -c1-200)
    [ "$rc1" = 0 ] || msg=$($B head -n1 "$T/out1" | $B cut -c1-200)
    if [ "$rc1" != 0 ] || [ "$rc2" != 0 ]; then
        fail 9004 "${msg:-Пакет dns не выполнил команду}" "$T/out"
    fi
    x name dns
    svc_state dns
    xfile output "$T/out"
}
act_svc_dns_enable() { dns_do_pair enable start; }
act_svc_dns_disable() { dns_do_pair stop disable; }

act_svc_dns_adblock() {
    is_flag "$P_on" || fail 9003 "Неверное значение: on"
    if [ "$P_on" = 1 ]; then svc_dns_do adblock on; else svc_dns_do adblock off; fi
}

act_svc_show() {
    local d n
    printf '<services>'
    for d in "$PKG"/*; do
        [ -f "$d/svc.sh" ] || continue
        n=${d##*/}
        printf '<service>'; x name "$n"; x desc "$($B head -n1 "$d/desc" 2>/dev/null)"
        svc_state "$n"
        printf '</service>'
    done
    printf '</services>'
}

svc_do() {
    check_pkg_name
    svc_exec 60 "$P_name" "$1" > "$T/out" 2>&1
    local rc=$?
    log "svc $P_name $1 rc=$rc"
    x name "$P_name"
    x rc "$rc"
    svc_state "$P_name"
    xfile output "$T/out"
}

act_svc_start() { svc_do start; }
act_svc_stop() { svc_do stop; }
act_svc_enable() { svc_do enable; }
act_svc_disable() { svc_do disable; }
act_svc_status() { svc_do status; }

