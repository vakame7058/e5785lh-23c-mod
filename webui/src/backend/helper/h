# ---------- radio: режим сети и диапазоны LTE (AT^SYSCFGEX) ----------

# диапазоны LTE роутера (маска 0x20880800C5)
LTE_BANDS='1 3 7 8 20 28 32 38'

act_radio_show() {
    local b m
    at_run 'AT^SYSCFGEX?'
    IFS=, ; set -- $(at_field_line '^SYSCFGEX'); IFS=$OIFS
    x mode "$1"
    x lte_mask "$5"
    printf '<lte_bands>'
    case "$5" in
        ''|*[!0-9A-Fa-f]*) ;;
        *)
            m=$((0x$5))
            for b in $LTE_BANDS; do
                printf '<band>'; x num "$b"; x on $(((m >> (b - 1)) & 1)); printf '</band>'
            done
            ;;
    esac
    printf '</lte_bands>'
    xfile output "$T/at"
}

act_radio_set() {
    local mode=$P_mode mask b ok
    case "$mode" in ''|00|01|02|03|0302|0301|0201) ;; *) fail 9003 "Неверное значение: mode" ;; esac
    if [ -n "$P_bands" ]; then
        mask=0
        for b in $(echo "$P_bands" | $B tr ',' ' '); do
            ok=0
            for c in $LTE_BANDS; do [ "$b" = "$c" ] && ok=1; done
            [ $ok = 1 ] || fail 9003 "Неверное значение: bands (нет диапазона $b)"
            mask=$((mask | (1 << (b - 1))))
        done
        [ "$mask" -ne 0 ] || fail 9003 "Неверное значение: bands"
        mask=$(printf '%X' "$mask")
    fi
    [ -n "$mode" ] || [ -n "$mask" ] || fail 9003 "Нужно поле mode или bands"
    need_modem_write
    at_run 'AT^SYSCFGEX?'
    IFS=, ; set -- $(at_field_line '^SYSCFGEX'); IFS=$OIFS
    [ $# -ge 5 ] || fail 9004 "Не удалось прочитать текущие настройки" "$T/at"
    # остальные поля — как сейчас
    at_run "AT^SYSCFGEX=\"${mode:-$1}\",$2,$3,$4,${mask:-$5},,"
    log "radio mode=${mode:-$1} lte=${mask:-$5}"
    at_ok || fail 9004 "Модем ответил ошибкой" "$T/at"
    act_radio_show
}

