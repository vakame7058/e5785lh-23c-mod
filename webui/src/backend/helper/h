        x connect_ms "$ms"; x status "$st"; x up_kbps "$uk"; x up_cpu_avg "$uc"; x up_server "$us"
        x streams "${ns:-1}"; x mt_kbps "$mk"; x up_mt_kbps "$umk"
        printf '</run>'
    done < "$SPEED_HIST"
    printf '</history>'
}

act_speedtest_show() {
    if speed_running; then
        speed_live_xml
        return 0
    fi
    if [ -f "$RUN/speedtest" ]; then
        $B cat "$RUN/speedtest"
    else
        x status none
    fi
    speed_history_xml
}

act_speedtest_servers() {
    local id name cc url size range https med up
    [ -x "$CURL" ] && x curl 1 || x curl 0
    printf '<servers>'
    speed_list | while IFS='|' read -r id name cc url size range https med up; do
        case "$id" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
        printf '<server>'
