+static const char *const ROCKET_ART[11] = {
+    "rrr.................",
+    ".rrrr...............",
+    "..rrrrrr............",
+    "..WWWWWWRRWWWWNN....",
+    "GGWWWWWWRRWhBWNNNN..",
