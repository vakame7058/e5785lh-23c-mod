+static int planet_radius(void) {
+    int stage = (g.level - 1) % 5;
+    int len = g.level_len > 0 ? g.level_len : LEVEL_FRAMES;
+    int prog = (stage * len + clampi(g.level_frame, 0, len)) * 256 / (5 * len);
+    return clampi(5 + 41 * prog / 256, 5, PL_RMAX);
+}
