+static int earth_height(void) {
+    if (g.state == ST_TITLE) return 9;
+    if (g.level != 1) return 0;
+    if (g.state == ST_READY) return 22;
+    int len = g.level_len > 0 ? g.level_len : LEVEL_FRAMES;
+    return 22 - 26 * clampi(g.level_frame, 0, len) / (len / 2 + 1);
+}
