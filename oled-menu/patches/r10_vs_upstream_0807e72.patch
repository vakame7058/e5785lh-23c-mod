+        circle(x, y, r - 2, RGB(40, 120, 220), 150);
+        px(x - 2, y - 2, RGB(240, 250, 255));
+        px(x - 1, y - 3, RGB(200, 240, 255));
+        break;
+    }
+    default:
+        break;
+    }
+}
