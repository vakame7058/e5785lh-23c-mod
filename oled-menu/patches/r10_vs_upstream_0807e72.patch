+        paint_menu_small(curr_item, items);
+        return;
+    }
+    const int page_first_item = curr_item / lines_per_page * lines_per_page;
+    int total = 0;
+    while (total < MAXMENUITEMS && items[total][0]) {
+        total += 1;
+    }
+
+    for (int i = 0; i < lines_per_page && page_first_item + i < total; i += 1) {
+        char cur_line[MAXITEMLEN];
+        strncpy(cur_line, items[page_first_item + i], MAXITEMLEN);
+        cur_line[MAXITEMLEN - 1] = 0;
+        int y = 1 + i * MENU_ROW;
+
+        char *saveptr;
+        char *item_type = strtok_r(cur_line, ":", &saveptr);
+        if (!item_type) {
+            continue;
         }
+        int is_item = (strcmp(item_type, "item") == 0);
+        char *text = strtok_r(NULL, is_item ? ":" : "\n", &saveptr);
+        if (!text) {
+            continue;
+        }
+
+        if (!is_item) {
+            aa_put_text(&font_m, 4, y + 1, MENU_TEXT, text);
+            continue;
+        }
+        if (page_first_item + i == curr_item) {
+            aa_round_rect(1, y, 124, MENU_ROW - 1, 3, MENU_FRAME, 0);
+        }
+        int x = 7;
+        size_t len = strlen(text);
+        if (strncmp(text, "<- ", 3) == 0) {
+            aa_put_text(&font_m, x, y + 1, MENU_TEXT, "\xe2\x86\x90");     /* ← */
+            text += 3;
+            x = 21;
+        } else if (len >= 2 && text[0] == '<' && text[len - 1] == '>') {
+            aa_put_text(&font_m, x, y + 1, RGB565(0, 220, 90), "\xe2\x97\x8f");  /* ● */
+            text[len - 1] = 0;
+            text += 1;
+            x = 20;
+        } else if (text[0] == ' ') {
+            aa_put_text(&font_m, x, y + 1, MENU_DIM, "\xe2\x97\x8b");     /* ○ */
+            text += 1;
+            x = 20;
+        }
+        aa_put_text_fit(&font_m, x, y + 1, 123 - x, MENU_TEXT, text);
     }
+    paint_scrollbar(1, lines_per_page * MENU_ROW - 1, page_first_item, lines_per_page, total);
 }
 
