+static void copy_str(char *dst, int len, const char *src) {
+    int i = 0;
+    if (src) {
+        for (; i < len - 1 && src[i]; i += 1) {
+            dst[i] = src[i];
+        }
+    }
+    dst[i] = 0;
+    /* обрезать пробелы по краям */
+    while (i > 0 && dst[i - 1] == ' ') {
+        dst[--i] = 0;
+    }
+    int s = 0;
+    while (dst[s] == ' ') {
+        s += 1;
+    }
+    if (s) {
+        memmove(dst, dst + s, strlen(dst + s) + 1);
+    }
+}
